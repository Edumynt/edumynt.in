{
  "name": "edumynt",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "app:start": "npm --prefix ../edumyntinapp start -- --clear",
    "app:android": "npm --prefix ../edumyntinapp run android",
    "app:ios": "npm --prefix ../edumyntinapp run ios",
    "app:web": "npm --prefix ../edumyntinapp run web",
    "app:typecheck": "npm --prefix ../edumyntinapp run typecheck",
    "app:doctor": "npm --prefix ../edumyntinapp run doctor",
    "cf:dev": "wrangler pages dev ./dist",
    "cf:deploy": "wrangler pages deploy ./dist"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^6.3.3",
    "astro-compress": "^2.4.1",
    "astro-icon": "^1.1.5",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "wrangler": "^3.25.0"
  }
}
