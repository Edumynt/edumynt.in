---
export interface Props {
  href?: string;
  class?: string;
  [key: string]: unknown;
}

const { href, class: className = '', ...attrs } = Astro.props;
const classes = [
  'overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition duration-300',
  href ? 'hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl' : '',
  className,
].join(' ');
---

{href ? (
  <a href={href} class={classes} {...attrs}>
    <slot />
  </a>
) : (
  <div class={classes} {...attrs}>
    <slot />
  </div>
)}
