---
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- Mindmap Modal Overlay -->
<div class="fixed inset-0 z-[70] bg-black/50 backdrop-blur-sm opacity-0 invisible transition-all duration-300" id="mindmapOverlay"></div>

<!-- Mindmap Modal -->
<div class={`mindmap-modal ${className || ''}`} id="mindmapModal">
  <!-- Modal Header -->
  <div class="mindmap-modal-header">
    <div class="modal-title-section">
      <div class="modal-icon">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
      </div>
      <div>
        <h3 class="modal-title" id="mindmapTitle">Mindmap</h3>
        <p class="modal-subtitle" id="mindmapSubtitle">Interactive visualization</p>
      </div>
    </div>
    
    <div class="modal-actions">
      <button class="modal-action-btn" id="mindmapFullscreen" title="Fullscreen">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5" />
        </svg>
      </button>
      
      <button class="modal-action-btn" id="closeMindmapModal" title="Close">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Modal Content -->
  <div class="mindmap-modal-content">
    <!-- Search Bar -->
    <div class="mindmap-search-container">
      <div class="search-input-wrapper">
        <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
          <path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="2"/>
        </svg>
        <input 
          type="text" 
          id="mindmapSearchInput" 
          class="search-input" 
          placeholder="Search mindmap content..."
          autocomplete="off"
        />
        <button class="search-clear-btn hidden" id="clearSearch" title="Clear search">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <!-- Search Results -->
      <div class="search-results hidden" id="searchResults">
        <div class="search-results-header">
          <span class="results-count" id="resultsCount">0 results</span>
          <button class="close-results-btn" id="closeResults">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="search-results-list" id="searchResultsList">
          <!-- Results will be populated dynamically -->
        </div>
      </div>
    </div>

    <div class="mindmap-container" id="mindmapContainer">
      <!-- Mindmap will be dynamically loaded here -->
    </div>
  </div>

  <!-- Modal Footer -->
  <div class="mindmap-modal-footer">
    <div class="mindmap-info">
      <span class="info-item" id="nodeCount">0 nodes</span>
      <span class="info-separator">•</span>
      <span class="info-item" id="depthInfo">Max depth: 0</span>
    </div>
    
    <div class="mindmap-actions">
      <button class="action-btn secondary" id="resetView">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0V9a8 8 0 1115.356 2M15 15v5h-.582M8.582 15A8.001 8.001 0 0019.418 15m0 0V15a8 8 0 01-15.356-2" />
        </svg>
        Reset View
      </button>
      
      <button class="action-btn secondary" id="exportMindmap">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Export
      </button>
    </div>
  </div>
</div>

<script>
  import { initializeMindmapModal } from '../../lib/mindmap/controller.js';
  
  // Initialize mindmap functionality
  initializeMindmapModal();
</script>

<style>
  .mindmap-modal {
    position: fixed;
    top: 2vh;
    left: 2vw;
    right: 2vw;
    bottom: 2vh;
    z-index: 75;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 16px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.95) translateY(20px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mindmap-modal.active {
    transform: scale(1) translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .mindmap-modal.fullscreen {
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 0;
  }

  .mindmap-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    flex-shrink: 0;
  }

  .modal-title-section {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .modal-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    border-radius: 8px;
  }

  .modal-title {
    font-size: 18px;
    font-weight: 600;
    color: hsl(var(--foreground));
    margin: 0;
    line-height: 1.4;
  }

  .modal-subtitle {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    margin: 0;
    line-height: 1.4;
  }

  .modal-actions {
    display: flex;
    gap: 4px;
  }

  .modal-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: hsl(var(--muted-foreground));
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .modal-action-btn:hover {
    background: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
  }

  .mindmap-modal-content {
    flex: 1;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .mindmap-search-container {
    position: relative;
    z-index: 10;
    background: hsl(var(--background));
    border-bottom: 1px solid hsl(var(--border));
    padding: 16px 20px;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    width: 16px;
    height: 16px;
    color: hsl(var(--muted-foreground));
    pointer-events: none;
    z-index: 1;
  }

  .search-input {
    width: 100%;
    height: 40px;
    padding: 0 40px 0 40px;
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    font-size: 14px;
    transition: all 0.2s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: hsl(var(--primary));
    box-shadow: 0 0 0 2px hsl(var(--primary) / 0.2);
  }

  .search-clear-btn {
    position: absolute;
    right: 8px;
    width: 24px;
    height: 24px;
    border: none;
    background: transparent;
    color: hsl(var(--muted-foreground));
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .search-clear-btn:hover {
    background: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
  }

  .search-clear-btn svg {
    width: 12px;
    height: 12px;
  }

  .search-results {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-top: none;
    border-radius: 0 0 8px 8px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    max-height: 300px;
    overflow: hidden;
    z-index: 20;
  }

  .search-results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: hsl(var(--muted));
    border-bottom: 1px solid hsl(var(--border));
    font-size: 12px;
  }

  .results-count {
    color: hsl(var(--muted-foreground));
    font-weight: 500;
  }

  .close-results-btn {
    width: 20px;
    height: 20px;
    border: none;
    background: transparent;
    color: hsl(var(--muted-foreground));
    border-radius: 3px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .close-results-btn:hover {
    background: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
  }

  .close-results-btn svg {
    width: 12px;
    height: 12px;
  }

  .search-results-list {
    max-height: 250px;
    overflow-y: auto;
  }

  .search-result-item {
    padding: 12px;
    border-bottom: 1px solid hsl(var(--border));
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .search-result-item:last-child {
    border-bottom: none;
  }

  .search-result-item:hover {
    background: hsl(var(--accent));
  }

  .search-result-title {
    font-size: 14px;
    font-weight: 500;
    color: hsl(var(--foreground));
    margin-bottom: 4px;
    line-height: 1.4;
  }

  .search-result-path {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    line-height: 1.3;
  }

  .search-highlight {
    background: hsl(var(--primary) / 0.2);
    color: hsl(var(--primary));
    font-weight: 600;
    border-radius: 2px;
    padding: 1px 2px;
  }

  .mindmap-container {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .mindmap-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-top: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    flex-shrink: 0;
  }

  .mindmap-info {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
  }

  .info-separator {
    opacity: 0.5;
  }

  .mindmap-actions {
    display: flex;
    gap: 8px;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    font-size: 13px;
    font-weight: 500;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    background: hsl(var(--accent));
    border-color: hsl(var(--accent));
  }

  .action-btn.secondary {
    background: transparent;
    color: hsl(var(--muted-foreground));
  }

  .action-btn.secondary:hover {
    background: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
  }

  /* Mobile optimizations */
  @media (max-width: 768px) {
    .mindmap-modal {
      top: 1vh;
      left: 1vw;
      right: 1vw;
      bottom: 1vh;
      border-radius: 12px;
    }

    .mindmap-modal-header {
      padding: 12px 16px;
    }

    .modal-title {
      font-size: 16px;
    }

    .modal-subtitle {
      font-size: 12px;
    }

    .mindmap-modal-footer {
      padding: 10px 16px;
      flex-direction: column;
      gap: 12px;
      align-items: stretch;
    }

    .mindmap-actions {
      justify-content: center;
    }

    .action-btn {
      flex: 1;
      justify-content: center;
      padding: 8px 12px;
    }
  }

  /* Very small screens */
  @media (max-width: 480px) {
    .modal-title-section {
      gap: 8px;
    }

    .modal-icon {
      width: 32px;
      height: 32px;
    }

    .modal-actions {
      gap: 2px;
    }

    .modal-action-btn {
      width: 32px;
      height: 32px;
    }
  }
</style>