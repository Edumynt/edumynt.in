---
import type { MindmapData } from '../../lib/mindmap/types.js';

export interface Props {
  mindmapData: MindmapData;
  class?: string;
}

const { mindmapData, class: className } = Astro.props;
---

<div class={`mindmap-viewer ${className || ''}`} data-mindmap-container>
  <!-- Mindmap Controls -->
  <div class="mindmap-controls">
    <button class="control-btn" data-action="zoom-in" title="Zoom In">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
        <path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="2"/>
        <path d="M11 8v6M8 11h6" stroke="currentColor" stroke-width="2"/>
      </svg>
    </button>
    
    <button class="control-btn" data-action="zoom-out" title="Zoom Out">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
        <path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="2"/>
        <path d="M8 11h6" stroke="currentColor" stroke-width="2"/>
      </svg>
    </button>
    
    <button class="control-btn" data-action="center" title="Center View">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path d="M3 3l18 18M3 21L21 3" stroke="currentColor" stroke-width="2"/>
      </svg>
    </button>
    
    <button class="control-btn" data-action="expand-all" title="Expand All">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3" stroke="currentColor" stroke-width="2"/>
      </svg>
    </button>
  </div>

  <!-- SVG Container -->
  <svg 
    class="mindmap-svg" 
    data-mindmap-svg
    viewBox="0 0 800 600"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Content will be rendered by JavaScript -->
  </svg>

  <!-- Loading State -->
  <div class="mindmap-loading" data-loading>
    <div class="loading-spinner"></div>
    <p>Loading mindmap...</p>
  </div>

  <!-- Error State -->
  <div class="mindmap-error hidden" data-error>
    <div class="error-icon">⚠️</div>
    <p>Failed to load mindmap</p>
    <button class="retry-btn" data-retry>Retry</button>
  </div>
</div>

<style>
  .mindmap-viewer {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 400px;
    background: hsl(var(--background));
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
  }

  .mindmap-controls {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
    display: flex;
    gap: 4px;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    padding: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .control-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    color: hsl(var(--muted-foreground));
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .control-btn:hover {
    background: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
  }

  .control-btn:active {
    transform: scale(0.95);
  }

  .mindmap-svg {
    width: 100%;
    height: 100%;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .mindmap-svg:active {
    cursor: grabbing;
  }

  .mindmap-loading,
  .mindmap-error {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: hsl(var(--background));
    color: hsl(var(--muted-foreground));
    gap: 16px;
  }

  .loading-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid hsl(var(--border));
    border-top: 3px solid hsl(var(--primary));
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  .error-icon {
    font-size: 32px;
  }

  .retry-btn {
    padding: 8px 16px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s ease;
  }

  .retry-btn:hover {
    background: hsl(var(--accent));
  }

  .hidden {
    display: none !important;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Mobile optimizations */
  @media (max-width: 768px) {
    .mindmap-viewer {
      min-height: 300px;
    }
    
    .mindmap-controls {
      top: 8px;
      right: 8px;
      gap: 2px;
      padding: 2px;
    }
    
    .control-btn {
      width: 32px;
      height: 32px;
    }
    
    .control-btn svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

<script>
  import { MindmapParser } from '../../lib/mindmap/parser.js';
  import { MobileLayoutEngine } from '../../lib/mindmap/layout.js';
  import { SVGMindmapRenderer } from '../../lib/mindmap/renderer.js';
  import type { MindmapData, ViewportState, MindmapEvents } from '../../lib/mindmap/types.js';

  class MindmapViewerController {
    private container: HTMLElement;
    private svg: SVGSVGElement;
    private loadingEl: HTMLElement;
    private errorEl: HTMLElement;
    private parser: MindmapParser;
    private layoutEngine: MobileLayoutEngine;
    private renderer: SVGMindmapRenderer | null = null;
    private mindmapData: MindmapData | null = null;
    private isMobile: boolean;
    private viewport: ViewportState;

    constructor(container: HTMLElement) {
      this.container = container;
      this.svg = container.querySelector('[data-mindmap-svg]') as SVGSVGElement;
      this.loadingEl = container.querySelector('[data-loading]') as HTMLElement;
      this.errorEl = container.querySelector('[data-error]') as HTMLElement;
      
      this.parser = new MindmapParser();
      this.isMobile = window.innerWidth <= 768;
      
      // Get container dimensions
      const rect = this.container.getBoundingClientRect();
      this.layoutEngine = new MobileLayoutEngine(rect.width, rect.height, this.isMobile);
      
      // Initialize viewport
      this.viewport = {
        zoom: 1,
        panX: 0,
        panY: 0,
        bounds: {
          minZoom: 0.1,
          maxZoom: 3.0,
          minX: -1000,
          maxX: 1000,
          minY: -1000,
          maxY: 1000
        }
      };

      this.initializeEvents();
    }

    private initializeEvents(): void {
      // Control buttons
      this.container.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const action = target.closest('[data-action]')?.getAttribute('data-action');
        
        switch (action) {
          case 'zoom-in':
            this.zoomIn();
            break;
          case 'zoom-out':
            this.zoomOut();
            break;
          case 'center':
            this.centerView();
            break;
          case 'expand-all':
            this.expandAll();
            break;
        }
      });

      // Retry button
      this.errorEl.querySelector('[data-retry]')?.addEventListener('click', () => {
        this.initialize();
      });

      // Window resize
      window.addEventListener('resize', () => {
        this.handleResize();
      });
    }

    private createMindmapEvents(): MindmapEvents {
      return {
        onNodeClick: (node) => {
          console.log('Node clicked:', node.title);
        },
        onNodeExpand: (node) => {
          this.parser.toggleNodeCollapse(node);
          this.rerenderMindmap();
        },
        onNodeCollapse: (node) => {
          this.parser.toggleNodeCollapse(node);
          this.rerenderMindmap();
        },
        onViewportChange: (viewport) => {
          this.viewport = viewport;
        }
      };
    }

    private rerenderMindmap(): void {
      if (!this.mindmapData || !this.renderer) return;
      
      // Recalculate layout
      this.layoutEngine.layoutNodes(this.mindmapData.root);
      
      // Re-render
      this.renderer.render(this.mindmapData);
    }

    private zoomIn(): void {
      const newZoom = Math.min(this.viewport.zoom * 1.2, this.viewport.bounds.maxZoom);
      this.renderer?.updateViewport({ zoom: newZoom });
    }

    private zoomOut(): void {
      const newZoom = Math.max(this.viewport.zoom / 1.2, this.viewport.bounds.minZoom);
      this.renderer?.updateViewport({ zoom: newZoom });
    }

    private centerView(): void {
      if (!this.mindmapData) return;
      
      const optimalViewport = this.layoutEngine.getOptimalViewport(this.mindmapData.root);
      this.renderer?.updateViewport(optimalViewport);
    }

    private expandAll(): void {
      if (!this.mindmapData) return;
      
      this.parser.expandToLevel(this.mindmapData.root, 3);
      this.rerenderMindmap();
    }

    private handleResize(): void {
      const rect = this.container.getBoundingClientRect();
      this.layoutEngine = new MobileLayoutEngine(rect.width, rect.height, window.innerWidth <= 768);
      
      if (this.mindmapData) {
        this.rerenderMindmap();
        this.centerView();
      }
    }

    private showLoading(): void {
      this.loadingEl.classList.remove('hidden');
      this.errorEl.classList.add('hidden');
    }

    private hideLoading(): void {
      this.loadingEl.classList.add('hidden');
    }

    private showError(): void {
      this.loadingEl.classList.add('hidden');
      this.errorEl.classList.remove('hidden');
    }

    public async initialize(rawContent?: string): Promise<void> {
      this.showLoading();
      
      try {
        // Parse mindmap data from embedded data or fetch it
        let content = rawContent;
        if (!content) {
          // Try to get content from data attribute or make API call
          content = this.container.getAttribute('data-mindmap-content') || '';
        }
        
        if (!content) {
          throw new Error('No mindmap content provided');
        }

        // Parse the content
        this.mindmapData = this.parser.parseContent(content);
        
        // Calculate layout
        this.layoutEngine.layoutNodes(this.mindmapData.root);
        
        // Initialize renderer
        const events = this.createMindmapEvents();
        this.renderer = new SVGMindmapRenderer(this.svg, this.viewport, events, this.isMobile);
        
        // Render mindmap
        this.renderer.render(this.mindmapData);
        
        // Set optimal view
        this.centerView();
        
        this.hideLoading();
        
      } catch (error) {
        console.error('Failed to initialize mindmap:', error);
        this.showError();
      }
    }

    public destroy(): void {
      this.renderer?.destroy();
    }
  }

  // Initialize all mindmap viewers on the page
  document.addEventListener('DOMContentLoaded', () => {
    const containers = document.querySelectorAll('[data-mindmap-container]');
    
    containers.forEach((container) => {
      const controller = new MindmapViewerController(container as HTMLElement);
      controller.initialize();
    });
  });
</script>