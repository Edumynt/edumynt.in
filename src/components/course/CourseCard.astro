---
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import type { CourseOutline } from '../../lib/course-data';
import { courseUrl, getImageAlt, getImageSrc } from '../../lib/course-data';

export interface Props {
  outline: CourseOutline;
  compact?: boolean;
}

const { outline, compact = false } = Astro.props;
const { course, stats, firstLesson } = outline;
const imageSrc = getImageSrc(course);
const imageAlt = getImageAlt(course);
---

<Card href={courseUrl(course)} class="group block h-full">
  <div class={compact ? 'relative h-48 overflow-hidden bg-gradient-to-br from-primary/20 to-primary/5' : 'relative h-56 overflow-hidden bg-gradient-to-br from-primary/20 to-primary/5'}>
    <img
      src={imageSrc}
      alt={imageAlt}
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      onerror="this.onerror=null; this.src='/images/course_placeholder.jpg';"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent"></div>
    <div class="absolute bottom-4 left-4 right-4">
      <div class="mb-3 flex flex-wrap gap-2">
        <Badge tone="light" class="capitalize">{course.data.difficulty}</Badge>
        {course.data.duration && <Badge tone="light">{course.data.duration}</Badge>}
        {course.data.featured && <Badge tone="light">Featured</Badge>}
      </div>
      <h2 class={compact ? 'line-clamp-2 text-xl font-display font-bold leading-tight text-white' : 'line-clamp-2 text-2xl font-display font-bold leading-tight text-white'}>
        {course.data.title}
      </h2>
    </div>
  </div>

  <div class={compact ? 'p-5' : 'p-6'}>
    <p class="mb-5 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{course.data.description}</p>

    {course.data.exams.length > 0 && (
      <div class="mb-5 flex flex-wrap gap-2">
        {course.data.exams.slice(0, compact ? 2 : 3).map(exam => (
          <Badge tone="primary">{exam}</Badge>
        ))}
      </div>
    )}

    <div class="flex items-center justify-between gap-4 border-t border-border pt-4">
      <div class="flex flex-wrap gap-4 text-xs font-semibold text-muted-foreground">
        <span>{stats.chapterCount} chapters</span>
        <span>{stats.lessonCount} lessons</span>
      </div>
      <span class="inline-flex items-center text-sm font-bold text-primary">
        Open
        <svg class="ml-1 h-4 w-4 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </span>
    </div>

    {firstLesson && !compact && (
      <div class="mt-4 rounded-xl bg-muted p-3">
        <div class="mb-1 text-xs font-bold uppercase tracking-wide text-muted-foreground">Start with</div>
        <span class="line-clamp-1 text-sm font-bold text-foreground">
          {firstLesson.data.title}
        </span>
      </div>
    )}
  </div>
</Card>
