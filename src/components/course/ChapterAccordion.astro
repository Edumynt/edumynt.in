---
import Badge from '../ui/Badge.astro';
import type { ChapterOutline } from '../../lib/course-data';
import { lessonUrl } from '../../lib/course-data';

export interface Props {
  chapters: ChapterOutline[];
}

const { chapters } = Astro.props;
---

<section class="space-y-3" data-chapter-accordion>
  {chapters.map((section, index) => {
    const isOpen = index === 0;

    return (
      <article
        class="overflow-hidden rounded-xl border border-border bg-card shadow-sm"
        data-chapter-item
        data-chapter-id={section.chapter.id}
        data-chapter-lesson-ids={section.lessons.map(lesson => lesson.id).join('|')}
      >
        <button
          class="flex w-full items-start justify-between gap-3 bg-muted/70 p-4 text-left transition hover:bg-muted sm:gap-4"
          type="button"
          aria-expanded={isOpen ? 'true' : 'false'}
          data-chapter-toggle
        >
          <div class="flex min-w-0 flex-1 items-start gap-3 sm:gap-4">
            <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg border border-border bg-card text-sm font-display font-extrabold text-foreground">
              {index + 1}
            </div>
            <div class="min-w-0 flex-1">
              <h2 class="mb-2 text-base font-display font-bold leading-snug text-foreground sm:text-lg">{section.chapter.data.title}</h2>
              <div class="flex flex-wrap gap-2">
                <Badge tone="muted">{section.lessonCount} lessons</Badge>
                <Badge tone="muted" class="hidden" data-chapter-progress-count>0/{section.lessonCount} done</Badge>
                {section.estimatedTime && <Badge tone="muted">{section.estimatedTime}</Badge>}
              </div>
              <div class="mt-3 hidden h-1.5 overflow-hidden rounded-full bg-background" data-chapter-progress-track>
                <div class="h-full rounded-full bg-primary transition-all duration-500" data-chapter-progress-bar style="width: 0%"></div>
              </div>
            </div>
          </div>
          <svg class={`mt-2 h-5 w-5 flex-shrink-0 text-muted-foreground transition duration-300 ${isOpen ? 'rotate-180' : ''}`} data-chapter-icon fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class={`grid transition-all duration-300 ${isOpen ? 'grid-rows-[1fr]' : 'grid-rows-[0fr]'}`} data-chapter-panel>
          <div class="overflow-hidden">
            {section.lessons.length > 0 ? (
              <div class="divide-y divide-border">
                {section.lessons.map((lesson, lessonIndex) => (
                  <a
                    href={lessonUrl(lesson)}
                    class="group flex items-start gap-3 p-3 transition hover:bg-muted/60 sm:px-4"
                    data-lesson-item
                    data-lesson-id={lesson.id}
                    data-lesson-title={lesson.data.title}
                    data-lesson-type={lesson.data.type}
                    data-lesson-complete="false"
                  >
                    <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary" data-lesson-status-icon>
                      <span data-lesson-number>{lessonIndex + 1}</span>
                      <svg class="hidden h-4 w-4" data-lesson-check fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <div class="min-w-0 flex-1">
                      <h3 class="text-sm font-display font-bold leading-snug text-foreground transition group-hover:text-primary sm:text-base" data-lesson-title-text>{lesson.data.title}</h3>
                      <div class="mt-2 flex flex-wrap gap-2">
                        <Badge tone="muted" class="capitalize">{lesson.data.type}</Badge>
                        {lesson.data.estimatedTime && <Badge tone="muted">{lesson.data.estimatedTime}</Badge>}
                        <Badge tone="muted" class="capitalize">{lesson.data.difficulty}</Badge>
                      </div>
                    </div>
                    <svg class="mt-1 h-5 w-5 flex-shrink-0 text-muted-foreground transition group-hover:translate-x-1 group-hover:text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </a>
                ))}
              </div>
            ) : (
              <div class="p-6 text-sm text-muted-foreground">No lessons published in this chapter yet.</div>
            )}
          </div>
        </div>
      </article>
    );
  })}
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-chapter-accordion]').forEach(accordion => {
      function setOpen(article, open) {
        const toggle = article?.querySelector('[data-chapter-toggle]');
        const panel = article?.querySelector('[data-chapter-panel]');
        const icon = article?.querySelector('[data-chapter-icon]');

        toggle?.setAttribute('aria-expanded', String(open));
        panel?.classList.toggle('grid-rows-[1fr]', open);
        panel?.classList.toggle('grid-rows-[0fr]', !open);
        icon?.classList.toggle('rotate-180', open);
      }

      accordion.querySelectorAll('[data-chapter-toggle]').forEach(toggle => {
        toggle.addEventListener('click', () => {
          const article = toggle.closest('article');
          const isOpen = toggle.getAttribute('aria-expanded') === 'true';
          setOpen(article, !isOpen);
        });
      });

      accordion.addEventListener('edumynt:chapters-open-all', () => {
        accordion.querySelectorAll('[data-chapter-item]').forEach(article => setOpen(article, true));
      });

      accordion.addEventListener('edumynt:chapters-collapse-all', () => {
        accordion.querySelectorAll('[data-chapter-item]').forEach(article => setOpen(article, false));
      });

      try {
        const progress = JSON.parse(localStorage.getItem('edumynt_course_progress') || '{}');
        const courseProgress = progress.courseProgress || {};
        const lastVisited = progress.lastVisitedCourse;

        accordion.querySelectorAll('[data-chapter-item]').forEach(article => {
          if (!(article instanceof HTMLElement)) return;
          const courseId = (article.dataset.chapterId || '').split('/')[0];
          const visited = courseProgress[courseId]?.visitedLessons || [];
          const lessons = (article.dataset.chapterLessonIds || '').split('|').filter(Boolean);
          const done = lessons.filter(id => visited.includes(id)).length;
          const badge = article.querySelector('[data-chapter-progress-count]');
          const progressTrack = article.querySelector('[data-chapter-progress-track]');
          const progressBar = article.querySelector('[data-chapter-progress-bar]');
          const percent = lessons.length > 0 ? Math.round((done / lessons.length) * 100) : 0;

          if (badge) {
            badge.textContent = `${done}/${lessons.length} done`;
            badge.classList.toggle('hidden', done === 0);
          }

          if (progressTrack) progressTrack.classList.toggle('hidden', done === 0);
          if (progressBar instanceof HTMLElement) progressBar.style.width = `${percent}%`;
          article.dataset.chapterComplete = String(lessons.length > 0 && done === lessons.length);
        });

        accordion.querySelectorAll('[data-lesson-item]').forEach(item => {
          if (!(item instanceof HTMLElement)) return;

          const courseId = (item.dataset.lessonId || '').split('/')[0];
          const visited = courseProgress[courseId]?.visitedLessons || [];
          const isComplete = visited.includes(item.dataset.lessonId || '');
          const isCurrent = lastVisited?.lessonId === item.dataset.lessonId;
          const marker = item.querySelector('[data-lesson-status-icon]');
          const number = item.querySelector('[data-lesson-number]');
          const check = item.querySelector('[data-lesson-check]');
          const title = item.querySelector('[data-lesson-title-text]');

          item.dataset.lessonComplete = String(isComplete);
          item.classList.toggle('bg-muted/40', isComplete);
          item.classList.toggle('ring-1', isCurrent);
          item.classList.toggle('ring-primary/30', isCurrent);
          marker?.classList.toggle('bg-primary', isComplete);
          marker?.classList.toggle('text-primary-foreground', isComplete);
          marker?.classList.toggle('bg-primary/10', !isComplete);
          marker?.classList.toggle('text-primary', !isComplete);
          number?.classList.toggle('hidden', isComplete);
          check?.classList.toggle('hidden', !isComplete);
          title?.classList.toggle('text-muted-foreground', isComplete);
          title?.classList.toggle('text-foreground', !isComplete);
        });

        document.dispatchEvent(new CustomEvent('edumynt:course-progress-ready'));
      } catch {
        localStorage.removeItem('edumynt_course_progress');
      }
    });
  });
</script>
