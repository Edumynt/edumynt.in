---
import CourseCard from './CourseCard.astro';
import type { CourseOutline } from '../../lib/course-data';

export interface Props {
  outlines: CourseOutline[];
}

const { outlines } = Astro.props;
---

<section class="mb-10" data-course-carousel>
  <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-muted-foreground">Courses</p>
      <h2 class="mb-3 text-3xl font-display font-extrabold tracking-tight text-foreground md:text-4xl">Explore courses</h2>
      <p class="max-w-2xl text-muted-foreground">Browse structured literature courses with chapters and lessons.</p>
    </div>
    <a href="/courses" class="inline-flex items-center justify-center rounded-xl border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground shadow-sm transition hover:border-primary/40 hover:text-primary">
      View all courses
    </a>
  </div>

  <div class="relative">
    <div class="overflow-hidden rounded-2xl" data-carousel-viewport>
      <div class="flex gap-6 transition-transform duration-300 ease-out" data-carousel-track>
        {outlines.map(outline => (
          <article class="w-[20rem] flex-shrink-0 sm:w-[22rem]">
            <CourseCard outline={outline} compact />
          </article>
        ))}
      </div>
    </div>

    {outlines.length > 1 && (
      <>
        <button data-carousel-prev class="absolute left-2 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-background/90 text-foreground shadow-lg backdrop-blur transition hover:scale-105 hover:bg-background disabled:opacity-40" aria-label="Previous course">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button data-carousel-next class="absolute right-2 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-background/90 text-foreground shadow-lg backdrop-blur transition hover:scale-105 hover:bg-background disabled:opacity-40" aria-label="Next course">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </>
    )}
  </div>

  {outlines.length > 1 && (
    <div class="mt-6 flex justify-center gap-2" data-carousel-indicators>
      {outlines.map((_, index) => (
        <button class="h-2 w-2 rounded-full bg-muted transition hover:bg-primary/50" data-carousel-indicator data-index={index} aria-label={`Go to course ${index + 1}`}></button>
      ))}
    </div>
  )}
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-course-carousel]').forEach(root => {
      const viewport = root.querySelector('[data-carousel-viewport]');
      const track = root.querySelector('[data-carousel-track]');
      const prev = root.querySelector('[data-carousel-prev]');
      const next = root.querySelector('[data-carousel-next]');
      const indicators = Array.from(root.querySelectorAll('[data-carousel-indicator]'));
      const cards = track ? Array.from(track.children) : [];
      let currentIndex = 0;

      function getStep() {
        const firstCard = cards[0];
        if (!(firstCard instanceof HTMLElement)) return 0;
        return firstCard.getBoundingClientRect().width + 24;
      }

      function getMaxIndex() {
        if (!(viewport instanceof HTMLElement)) return 0;
        const step = getStep();
        if (!step) return 0;
        const visible = Math.max(1, Math.floor((viewport.clientWidth + 24) / step));
        return Math.max(0, cards.length - visible);
      }

      function update() {
        if (!(track instanceof HTMLElement)) return;
        const maxIndex = getMaxIndex();
        currentIndex = Math.min(Math.max(currentIndex, 0), maxIndex);
        track.style.transform = `translateX(-${currentIndex * getStep()}px)`;

        indicators.forEach(indicator => {
          const isActive = Number(indicator.getAttribute('data-index') || 0) === currentIndex;
          indicator.classList.toggle('bg-primary', isActive);
          indicator.classList.toggle('w-6', isActive);
          indicator.classList.toggle('bg-muted', !isActive);
        });

        if (prev instanceof HTMLButtonElement) prev.disabled = currentIndex === 0;
        if (next instanceof HTMLButtonElement) next.disabled = currentIndex === maxIndex;
      }

      prev?.addEventListener('click', () => {
        currentIndex -= 1;
        update();
      });

      next?.addEventListener('click', () => {
        currentIndex += 1;
        update();
      });

      indicators.forEach(indicator => {
        indicator.addEventListener('click', () => {
          currentIndex = Number(indicator.getAttribute('data-index') || 0);
          update();
        });
      });

      window.addEventListener('resize', update);
      update();
    });
  });
</script>
