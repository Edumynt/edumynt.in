---
import type { CourseOutline } from '../../lib/course-data';
import { getImageAlt, getImageSrc } from '../../lib/course-data';

export interface Props {
  outline: CourseOutline;
}

const { outline } = Astro.props;
const { course } = outline;
const imageSrc = getImageSrc(course);
const imageAlt = getImageAlt(course);
---

<section class="mb-6">
  <div class="relative aspect-video overflow-hidden rounded-2xl border border-border bg-muted shadow-sm">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="absolute inset-0 h-full w-full object-cover"
      onerror="this.onerror=null; this.src='/images/course_placeholder.jpg';"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7 lg:p-8">
      <h1 class="max-w-4xl text-3xl font-display font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl">
        {course.data.title}
      </h1>
    </div>
  </div>
</section>
