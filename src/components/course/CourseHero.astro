---
import Badge from '../ui/Badge.astro';
import type { CourseOutline } from '../../lib/course-data';
import { getImageAlt, getImageSrc, lessonUrl } from '../../lib/course-data';

export interface Props {
  outline: CourseOutline;
}

const { outline } = Astro.props;
const { course, stats, firstLesson } = outline;
const imageSrc = getImageSrc(course);
const imageAlt = getImageAlt(course);
const firstLessonUrl = firstLesson ? lessonUrl(firstLesson) : '/courses';
---

<section class="mb-6 overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
  <div class="relative min-h-[22rem] overflow-hidden sm:min-h-[24rem]">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="absolute inset-0 h-full w-full object-cover"
      onerror="this.onerror=null; this.src='/images/course_placeholder.jpg';"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/55 to-black/20"></div>
    <div class="relative flex min-h-[22rem] flex-col justify-end p-5 sm:min-h-[24rem] sm:p-8 lg:p-10">
      <div class="mb-4 flex flex-wrap gap-2">
        <Badge tone="light">Course</Badge>
        <Badge tone="light">{stats.chapterCount} chapters</Badge>
        <Badge tone="light">{stats.lessonCount} lessons</Badge>
        {course.data.duration && <Badge tone="light">{course.data.duration}</Badge>}
        <Badge tone="light" class="capitalize">{course.data.difficulty}</Badge>
      </div>

      <h1 class="mb-4 max-w-4xl text-4xl font-display font-extrabold tracking-tight text-white md:text-6xl">
        {course.data.title}
      </h1>
      <p class="mb-6 max-w-3xl text-base leading-relaxed text-white/85 md:text-lg">
        {course.data.longDescription || course.data.description}
      </p>

      <div class="flex flex-wrap gap-3">
        {firstLesson && (
          <a
            href={firstLessonUrl}
            class="inline-flex items-center justify-center gap-2 rounded-2xl bg-primary px-5 py-3 text-base font-bold text-primary-foreground shadow-sm transition hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
            data-course-primary-cta
          >
            <span data-course-primary-cta-label>Start learning</span>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        )}
        <button
          type="button"
          data-share-course
          class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/30 bg-white/15 px-5 py-3 text-base font-bold text-white shadow-sm backdrop-blur transition hover:bg-white/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          <span data-share-label>Share</span>
        </button>
        <a
          href="/courses"
          class="inline-flex items-center justify-center rounded-2xl border border-white/30 bg-white/15 px-5 py-3 text-base font-bold text-white shadow-sm backdrop-blur transition hover:bg-white/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          All courses
        </a>
      </div>
    </div>
  </div>
</section>
