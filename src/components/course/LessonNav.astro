---
import type { LessonContext } from '../../lib/course-data';
import { courseUrl, lessonUrl } from '../../lib/course-data';

export interface Props {
  context: LessonContext;
}

const { context } = Astro.props;
const progress = context.totalLessons > 0 ? Math.round(((context.lessonIndex + 1) / context.totalLessons) * 100) : 0;
---

<nav class="mt-10 grid gap-4 border-t border-border pt-8 md:grid-cols-3">
  {context.previousLesson ? (
    <a href={lessonUrl(context.previousLesson)} class="group rounded-2xl border border-border bg-card p-5 shadow-sm transition hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg">
      <div class="mb-2 text-xs font-bold uppercase tracking-wide text-muted-foreground">Previous</div>
      <div class="line-clamp-2 font-display font-bold text-foreground group-hover:text-primary">{context.previousLesson.data.title}</div>
    </a>
  ) : (
    <div class="rounded-2xl border border-dashed border-border p-5 text-sm text-muted-foreground">First lesson in this course.</div>
  )}

  <a href={courseUrl(context.course)} class="rounded-2xl border border-border bg-muted p-5 text-center shadow-sm transition hover:border-primary/40 hover:text-primary">
    <div class="mb-2 text-xs font-bold uppercase tracking-wide text-muted-foreground">Course progress</div>
    <div class="mb-3 font-display text-2xl font-extrabold text-foreground">{progress}%</div>
    <div class="h-2 overflow-hidden rounded-full bg-background">
      <div class="h-full rounded-full bg-primary" style={`width: ${progress}%`}></div>
    </div>
    <div class="mt-3 text-xs font-semibold text-muted-foreground">
      Lesson {context.lessonIndex + 1} of {context.totalLessons}
    </div>
  </a>

  {context.nextLesson ? (
    <a href={lessonUrl(context.nextLesson)} class="group rounded-2xl border border-border bg-card p-5 text-right shadow-sm transition hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg">
      <div class="mb-2 text-xs font-bold uppercase tracking-wide text-muted-foreground">Next</div>
      <div class="line-clamp-2 font-display font-bold text-foreground group-hover:text-primary">{context.nextLesson.data.title}</div>
    </a>
  ) : (
    <div class="rounded-2xl border border-dashed border-border p-5 text-right text-sm text-muted-foreground">Last lesson in this course.</div>
  )}
</nav>
