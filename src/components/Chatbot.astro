---
// This component appears on all pages - no props needed
---

<!-- Chat Toggle Button -->
<button 
  id="chat-toggle"
  class="fixed bottom-4 right-4 z-50 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white rounded-full p-4 shadow-lg transition-all duration-300 hover:scale-105"
  aria-label="Open chat assistant"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
  </svg>
</button>

<!-- Full Screen Chat Window -->
<div id="chat-window" class="fixed inset-0 z-50 hidden bg-white flex flex-col">
  <!-- Header -->
  <div class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white p-4 flex justify-between items-center safe-area-inset-top">
    <div>
      <h3 class="font-semibold text-lg">Edumynt Assistant</h3>
      <p class="text-xs text-blue-100">Ask me anything about the courses!</p>
    </div>
    <button id="chat-close" class="text-white/80 hover:text-white transition-colors p-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Messages Container -->
  <div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4 bg-gray-50">
    <!-- Welcome message -->
    <div class="bg-white rounded-2xl rounded-tl-sm p-4 shadow-sm max-w-[90%]">
      <p class="text-sm text-gray-700">
        👋 Hi! I'm your Edumynt assistant. I can help you with:
      </p>
      <ul class="text-sm text-gray-600 mt-2 space-y-1">
        <li>• Course content and explanations</li>
        <li>• Literary works and authors</li>
        <li>• Exam preparation tips</li>
        <li>• Any questions about the site</li>
      </ul>
    </div>
    
    <!-- Suggested questions -->
    <div class="space-y-2">
      <p class="text-xs text-gray-500 font-medium">Try asking:</p>
      <div class="flex flex-wrap gap-2">
        <button class="suggested-question text-xs bg-white border border-gray-200 rounded-full px-3 py-2 text-gray-600 hover:bg-blue-50 hover:border-blue-300 hover:text-blue-600 transition-colors">
          What courses are available?
        </button>
        <button class="suggested-question text-xs bg-white border border-gray-200 rounded-full px-3 py-2 text-gray-600 hover:bg-blue-50 hover:border-blue-300 hover:text-blue-600 transition-colors">
          Tell me about Indian Writers
        </button>
        <button class="suggested-question text-xs bg-white border border-gray-200 rounded-full px-3 py-2 text-gray-600 hover:bg-blue-50 hover:border-blue-300 hover:text-blue-600 transition-colors">
          Explain Romanticism
        </button>
        <button class="suggested-question text-xs bg-white border border-gray-200 rounded-full px-3 py-2 text-gray-600 hover:bg-blue-50 hover:border-blue-300 hover:text-blue-600 transition-colors">
          UGC NET exam tips
        </button>
      </div>
    </div>
  </div>

  <!-- Input Area -->
  <div class="p-4 bg-white border-t border-gray-100 safe-area-inset-bottom">
    <form id="chat-form" class="flex gap-2">
      <input 
        type="text" 
        id="chat-input"
        placeholder="Type your question..."
        class="flex-1 border border-gray-200 rounded-xl px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
        autocomplete="off"
      />
      <button 
        type="submit"
        id="send-button"
        class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white rounded-xl px-5 py-3 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  #chat-messages::-webkit-scrollbar {
    width: 6px;
  }
  
  #chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  
  #chat-messages::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }
  
  #chat-messages::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }
  
  .message-enter {
    animation: messageSlide 0.2s ease-out;
  }
  
  @keyframes messageSlide {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .typing-indicator span {
    animation: typing 1.4s infinite;
  }
  
  .typing-indicator span:nth-child(2) {
    animation-delay: 0.2s;
  }
  
  .typing-indicator span:nth-child(3) {
    animation-delay: 0.4s;
  }
  
  @keyframes typing {
    0%, 60%, 100% {
      transform: translateY(0);
    }
    30% {
      transform: translateY(-4px);
    }
  }

  /* Safe area for mobile devices with notches */
  .safe-area-inset-top {
    padding-top: env(safe-area-inset-top);
  }
  
  .safe-area-inset-bottom {
    padding-bottom: env(safe-area-inset-bottom);
  }
</style>

<script>
  (function() {
    'use strict';
    
    // State
    let isLoading = false;
    
    // DOM elements
    const toggle = document.getElementById('chat-toggle');
    const chatWindow = document.getElementById('chat-window');
    const closeBtn = document.getElementById('chat-close');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input');
    const sendButton = document.getElementById('send-button');
    const messages = document.getElementById('chat-messages');
    const suggestedButtons = document.querySelectorAll('.suggested-question');
    
    // API URL
    const API_URL = '/api/chat';
    
    // Toggle chat window
    toggle.addEventListener('click', () => {
      chatWindow.classList.remove('hidden');
      toggle.classList.add('hidden');
      input.focus();
    });
    
    closeBtn.addEventListener('click', () => {
      chatWindow.classList.add('hidden');
      toggle.classList.remove('hidden');
    });
    
    // Handle suggested questions
    suggestedButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        input.value = btn.textContent.trim();
        form.dispatchEvent(new Event('submit'));
      });
    });
    
    // Add message to chat
    function addMessage(content, isUser = false) {
      const div = document.createElement('div');
      div.className = isUser 
        ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-2xl rounded-tr-sm p-4 shadow-sm max-w-[90%] ml-auto message-enter'
        : 'bg-white rounded-2xl rounded-tl-sm p-4 shadow-sm max-w-[90%] message-enter';
      
      // Simple markdown parsing
      const formattedContent = content
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/`(.*?)`/g, '<code class="bg-gray-100 px-1 rounded text-sm">$1</code>')
        .replace(/\n/g, '<br>');
      
      div.innerHTML = `<p class="text-sm ${isUser ? 'text-white' : 'text-gray-700'}">${formattedContent}</p>`;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }
    
    // Add typing indicator
    function addTypingIndicator() {
      const div = document.createElement('div');
      div.id = 'typing-indicator';
      div.className = 'bg-white rounded-2xl rounded-tl-sm p-4 shadow-sm max-w-[90%] message-enter';
      div.innerHTML = `
        <div class="typing-indicator flex gap-1">
          <span class="w-2 h-2 bg-gray-400 rounded-full"></span>
          <span class="w-2 h-2 bg-gray-400 rounded-full"></span>
          <span class="w-2 h-2 bg-gray-400 rounded-full"></span>
        </div>
      `;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }
    
    function removeTypingIndicator() {
      const indicator = document.getElementById('typing-indicator');
      if (indicator) indicator.remove();
    }
    
    // Get current page context
    function getPageContext() {
      const article = document.querySelector('article') || document.querySelector('main');
      if (!article) return '';
      return article.textContent?.substring(0, 3000) || '';
    }
    
    // Get course ID from URL
    function getCourseIdFromUrl() {
      const path = window.location.pathname;
      const match = path.match(/\/courses\/([^/]+)/);
      return match ? match[1] : '';
    }
    
    // Send message to API
    async function sendMessage(message) {
      const requestBody = {
        message: message,
        courseId: getCourseIdFromUrl(),
        courseContext: getPageContext(),
        pageUrl: window.location.pathname
      };
      
      const response = await fetch(API_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(requestBody),
      });
      
      if (!response.ok) {
        const errorText = await response.text();
        console.error('API Error Response:', errorText);
        let error;
        try {
          error = JSON.parse(errorText);
        } catch {
          error = { error: errorText || 'Unknown error' };
        }
        throw new Error(error.error || error.message || `HTTP error: ${response.status}`);
      }
      
      return response.json();
    }
    
    // Handle form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = input.value.trim();
      if (!message || isLoading) return;
      
      // Add user message
      addMessage(message, true);
      input.value = '';
      isLoading = true;
      sendButton.disabled = true;
      addTypingIndicator();
      
      try {
        const data = await sendMessage(message);
        removeTypingIndicator();
        
        if (data.choices && data.choices[0]) {
          addMessage(data.choices[0].message.content);
        } else {
          addMessage('I apologize, but I could not generate a response. Please try again.');
        }
      } catch (error) {
        removeTypingIndicator();
        console.error('Chat error:', error);
        addMessage(`Error: ${error.message}. Please try again later.`);
      } finally {
        isLoading = false;
        sendButton.disabled = false;
        input.focus();
      }
    });
    
    // Handle Enter key
    input.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.dispatchEvent(new Event('submit'));
      }
    });

    // Close chat on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !chatWindow.classList.contains('hidden')) {
        closeBtn.click();
      }
    });
  })();
</script>
