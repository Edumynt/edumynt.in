---
import { getCourseOutlines, courseUrl, lessonUrl } from '../lib/course-data';

export interface Props {
  pageType: 'home' | 'courses' | 'course' | 'lesson';
  title?: string;
  titleHref?: string;
  showFilter?: boolean;
  showBottomNav?: boolean;
}

const { pageType, title, titleHref, showFilter = false, showBottomNav: requestedShowBottomNav } = Astro.props;
const headerTitle = title || (pageType === 'home' ? 'Edumynt' : pageType === 'courses' ? 'Courses' : 'Course');
const headerHref = titleHref || (pageType === 'home' ? '/' : '/courses');
const showBottomNav = requestedShowBottomNav ?? (pageType === 'home' || pageType === 'courses');

const outlines = await getCourseOutlines();
const searchItems = outlines.flatMap(outline => [
  {
    title: outline.course.data.title,
    description: outline.course.data.description,
    type: 'Course',
    url: courseUrl(outline.course),
  },
  ...outline.lessons.map(lesson => ({
    title: lesson.data.title,
    description: lesson.data.description || lesson.data.excerpt || outline.course.data.title,
    type: 'Lesson',
    url: lessonUrl(lesson),
  })),
]);
const searchJson = JSON.stringify(searchItems).replace(/</g, '\\u003c');
---

<header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-xl lg:hidden">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <div class="flex min-w-0 items-center gap-4">
      <a href={headerHref} class="truncate text-lg font-display font-extrabold tracking-tight text-foreground">
        {headerTitle}
      </a>
    </div>

    <div class="flex items-center gap-2">
      <button type="button" data-open-site-search class="inline-flex h-10 w-10 items-center justify-center rounded-full text-muted-foreground transition hover:bg-muted hover:text-foreground" aria-label="Search site">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m1.6-5.4a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
        </svg>
      </button>

      {showFilter && (
        <button type="button" id="courseFilterButton" class="inline-flex h-10 w-10 items-center justify-center rounded-full text-muted-foreground transition hover:bg-muted hover:text-foreground" aria-label="Filter courses">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h18M6 12h12M10 19h4" />
          </svg>
        </button>
      )}
    </div>
  </div>
</header>

<aside class="fixed inset-y-0 left-0 z-50 hidden w-64 flex-col border-r border-border bg-card lg:flex" id="desktopSidebar">
  <div class="flex h-16 items-center gap-3 border-b border-border px-5">
    <a href="/" class="text-xl font-display font-extrabold tracking-tight text-foreground">
      Edumynt
    </a>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-4" aria-label="Primary">
    <div className="mb-1 px-3 text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground">
      Menu
    </div>
    <a href="/" class={`mt-1 flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition ${pageType === 'home' ? 'bg-primary/10 text-primary' : 'text-muted-foreground hover:bg-muted hover:text-foreground'}`}>
      <svg class="h-5 w-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      Home
    </a>
    <a href="/courses" class={`mt-1 flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition ${pageType === 'courses' || pageType === 'course' ? 'bg-primary/10 text-primary' : 'text-muted-foreground hover:bg-muted hover:text-foreground'}`}>
      <svg class="h-5 w-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      Courses
    </a>

    <div class="mt-6 mb-1 px-3 text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground">
      Library
    </div>
    {outlines.map(outline => (
      <a href={courseUrl(outline.course)} class={`mt-1 flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium transition truncate ${pageType === 'course' && headerTitle === outline.course.data.title ? 'bg-primary/10 text-primary' : 'text-muted-foreground hover:bg-muted hover:text-foreground'}`}>
        <svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span class="truncate">{outline.course.data.title}</span>
      </a>
    ))}
  </nav>

  <div class="border-t border-border p-3">
    <button type="button" data-open-site-search class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-muted-foreground transition hover:bg-muted hover:text-foreground">
      <svg class="h-5 w-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m1.6-5.4a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
      </svg>
      Search
    </button>
    <button type="button" id="sidebarSettingsButton" class="flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-muted-foreground transition hover:bg-muted hover:text-foreground">
      <svg class="h-5 w-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      Settings
    </button>
  </div>
</aside>

<div id="siteSearchOverlay" class="fixed inset-0 z-[90] hidden bg-black/50 p-4 backdrop-blur-sm">
  <div class="mx-auto mt-16 max-w-2xl overflow-hidden rounded-2xl border border-border bg-card shadow-2xl">
    <div class="flex items-center gap-3 border-b border-border p-4">
      <svg class="h-5 w-5 flex-shrink-0 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m1.6-5.4a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
      </svg>
      <input id="siteSearchInput" class="min-w-0 flex-1 bg-transparent text-base font-semibold text-foreground outline-none placeholder:text-muted-foreground" type="search" placeholder="Search courses and lessons" autocomplete="off" />
      <button type="button" data-close-site-search class="rounded-lg px-2 py-1 text-sm font-bold text-muted-foreground hover:bg-muted hover:text-foreground">Esc</button>
    </div>
    <div id="siteSearchResults" class="max-h-[60vh] overflow-y-auto p-2"></div>
  </div>
</div>

{showBottomNav && (
  <>
    <nav class="fixed bottom-0 left-0 right-0 z-40 border-t border-border bg-background/95 shadow-[0_-8px_24px_rgba(15,23,42,0.08)] backdrop-blur supports-[backdrop-filter]:bg-background/80 lg:hidden" aria-label="Primary">
      <div class="mx-auto flex max-w-7xl items-center justify-around px-2 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))]">
        <a href="/" class={`flex flex-col items-center gap-1 rounded-xl px-4 py-2 text-xs font-bold transition ${pageType === 'home' ? 'bg-primary/10 text-primary' : 'text-muted-foreground hover:bg-muted hover:text-foreground'}`}>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Home
        </a>

        <a href="/courses" class={`flex flex-col items-center gap-1 rounded-xl px-4 py-2 text-xs font-bold transition ${pageType === 'courses' || pageType === 'course' ? 'bg-primary/10 text-primary' : 'text-muted-foreground hover:bg-muted hover:text-foreground'}`}>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Courses
        </a>

        <button type="button" data-open-site-search class="flex flex-col items-center gap-1 rounded-xl px-4 py-2 text-xs font-bold text-muted-foreground transition hover:bg-muted hover:text-foreground" aria-label="Search">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m1.6-5.4a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
          </svg>
          Search
        </button>

        <button type="button" id="settingsButton" class="flex flex-col items-center gap-1 rounded-xl px-4 py-2 text-xs font-bold text-muted-foreground transition hover:bg-muted hover:text-foreground" aria-label="Open settings">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Settings
        </button>
      </div>
    </nav>

    <div class="invisible fixed inset-0 z-[70] bg-black/50 opacity-0 backdrop-blur-sm transition-all duration-300" id="settingsOverlay"></div>
    <aside class="fixed right-0 top-0 z-[80] flex h-full w-80 max-w-[85vw] translate-x-full flex-col rounded-l-2xl border-l border-border bg-card/95 shadow-2xl backdrop-blur-xl transition-transform duration-300" id="settingsDrawer">
      <div class="flex items-center justify-between border-b border-border p-6">
        <h3 class="font-display text-lg font-semibold text-foreground">Settings</h3>
        <button type="button" id="closeSettings" class="inline-flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground transition hover:bg-muted hover:text-foreground" aria-label="Close settings">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto p-6">
        <div class="flex items-center justify-between gap-4">
          <span class="font-semibold text-foreground">Dark mode</span>
          <button type="button" id="themeToggle" class="relative inline-flex h-6 w-11 items-center rounded-full bg-muted transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2" aria-label="Toggle dark mode">
            <span class="inline-block h-4 w-4 translate-x-1 rounded-full bg-background shadow-sm transition-transform" data-theme-toggle-slider></span>
          </button>
        </div>
      </div>
    </aside>
  </>
)}

<script type="application/json" id="siteSearchData" set:html={searchJson}></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('siteSearchOverlay');
    const input = document.getElementById('siteSearchInput');
    const results = document.getElementById('siteSearchResults');
    const dataEl = document.getElementById('siteSearchData');
    const items = JSON.parse(dataEl?.textContent || '[]');

    function renderResults(query) {
      if (!results) return;
      const normalized = query.trim().toLowerCase();
      const source = normalized
        ? items
            .map(item => {
              const haystack = `${item.title} ${item.description || ''} ${item.type}`.toLowerCase();
              if (!haystack.includes(normalized)) return undefined;
              const title = item.title.toLowerCase();
              const score = title === normalized ? 0 : title.startsWith(normalized) ? 1 : item.type === 'Course' ? 2 : 3;
              return { ...item, score };
            })
            .filter(Boolean)
            .sort((a, b) => a.score - b.score || a.title.localeCompare(b.title))
            .slice(0, 18)
        : items.slice(0, 10);

      const grouped = source.reduce((groups, item) => {
        const key = item.type === 'Course' ? 'Courses' : 'Lessons';
        groups[key] = groups[key] || [];
        groups[key].push(item);
        return groups;
      }, {});

      results.innerHTML = source.length
        ? Object.entries(grouped).map(([group, groupItems]) => `
          <section class="py-2">
            <h3 class="px-3 pb-1 text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground">${group}</h3>
            ${groupItems.map(item => `
              <a href="${item.url}" class="block rounded-xl p-3 transition hover:bg-muted">
                <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-muted-foreground">${item.type}</span>
                <span class="block font-display font-bold text-foreground">${item.title}</span>
                <span class="mt-1 line-clamp-1 block text-sm text-muted-foreground">${item.description || ''}</span>
              </a>
            `).join('')}
          </section>
        `).join('')
        : '<div class="p-6 text-center text-sm text-muted-foreground">No results found.</div>';
    }

    function openSearch() {
      overlay?.classList.remove('hidden');
      if (input instanceof HTMLInputElement) {
        input.value = '';
        renderResults('');
        requestAnimationFrame(() => input.focus());
      }
    }

    function closeSearch() {
      overlay?.classList.add('hidden');
    }

    document.querySelectorAll('[data-open-site-search]').forEach(button => button.addEventListener('click', openSearch));
    document.querySelectorAll('[data-close-site-search]').forEach(button => button.addEventListener('click', closeSearch));
    overlay?.addEventListener('click', event => {
      if (event.target === overlay) closeSearch();
    });
    input?.addEventListener('input', event => {
      const target = event.target;
      renderResults(target instanceof HTMLInputElement ? target.value : '');
    });
    document.addEventListener('keydown', event => {
      if (event.key === '/' && !(document.activeElement instanceof HTMLInputElement)) {
        event.preventDefault();
        openSearch();
      }
      if (event.key === 'Escape') closeSearch();
    });

    document.addEventListener('click', event => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest('[data-course-link]');
      if (!(link instanceof HTMLElement)) return;

      try {
        const storedRecent = JSON.parse(localStorage.getItem('edumynt_recent_courses') || '[]');
        const recent = Array.isArray(storedRecent) ? storedRecent : [];
        const next = [
          {
            id: link.dataset.courseId,
            title: link.dataset.courseTitle,
            url: link.dataset.courseUrl,
            timestamp: new Date().toISOString(),
          },
          ...recent.filter(item => item.id !== link.dataset.courseId),
        ].filter(item => item.id && item.url).slice(0, 6);
        localStorage.setItem('edumynt_recent_courses', JSON.stringify(next));
      } catch {
        localStorage.removeItem('edumynt_recent_courses');
      }
    });

    function syncCourseProgress() {
      try {
        const progress = JSON.parse(localStorage.getItem('edumynt_course_progress') || '{}');
        const courseProgress = progress.courseProgress || {};

        document.querySelectorAll('[data-course-link]').forEach(card => {
          if (!(card instanceof HTMLElement)) return;
          const courseId = card.dataset.courseId;
          const item = courseId ? courseProgress[courseId] : undefined;
          const visited = Array.isArray(item?.visitedLessons) ? item.visitedLessons.length : 0;
          const total = Number(item?.totalLessons || 0);
          const percent = total > 0 ? Math.min(100, Math.round((visited / total) * 100)) : 0;
          const wrap = card.querySelector('[data-course-progress-wrap]');
          const bar = card.querySelector('[data-course-progress-bar]');
          const label = card.querySelector('[data-course-progress-label]');

          wrap?.classList.toggle('hidden', percent === 0);
          if (bar instanceof HTMLElement) bar.style.width = `${percent}%`;
          if (label) label.textContent = `${percent}%`;
        });
      } catch {
        localStorage.removeItem('edumynt_course_progress');
      }
    }

    syncCourseProgress();

    const settingsButton = document.getElementById('settingsButton');
    const sidebarSettingsButton = document.getElementById('sidebarSettingsButton');
    const settingsDrawer = document.getElementById('settingsDrawer');
    const settingsOverlay = document.getElementById('settingsOverlay');
    const closeSettings = document.getElementById('closeSettings');
    const themeToggle = document.getElementById('themeToggle');

    function openSettings() {
      settingsDrawer?.classList.remove('translate-x-full');
      settingsOverlay?.classList.remove('opacity-0', 'invisible');
      document.body.style.overflow = 'hidden';
    }

    function closeSettingsFunc() {
      settingsDrawer?.classList.add('translate-x-full');
      settingsOverlay?.classList.add('opacity-0', 'invisible');
      document.body.style.overflow = '';
    }

    settingsButton?.addEventListener('click', openSettings);
    sidebarSettingsButton?.addEventListener('click', openSettings);
    closeSettings?.addEventListener('click', closeSettingsFunc);
    settingsOverlay?.addEventListener('click', closeSettingsFunc);

    if (themeToggle) {
      const slider = themeToggle.querySelector('[data-theme-toggle-slider]');

      function syncThemeToggle(isDark) {
        themeToggle.classList.toggle('bg-primary', isDark);
        themeToggle.classList.toggle('bg-muted', !isDark);
        slider?.classList.toggle('translate-x-6', isDark);
        slider?.classList.toggle('translate-x-1', !isDark);
      }

      syncThemeToggle(document.documentElement.classList.contains('dark'));

      themeToggle.addEventListener('click', () => {
        const nowDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', nowDark ? 'dark' : 'light');
        syncThemeToggle(nowDark);
      });
    }
  });
</script>
