---
import Button from './ui/Button.astro';

export interface Props {
  pageType: 'home' | 'courses' | 'course' | 'lesson';
}

const { pageType } = Astro.props;
---

<!-- Settings Drawer (right) -->
<div class="fixed inset-0 z-[70] bg-black/50 backdrop-blur-sm opacity-0 invisible transition-all duration-300" id="settingsOverlay"></div>
<aside class="fixed top-0 right-0 z-[80] h-full w-80 max-w-[85vw] bg-card/95 backdrop-blur-xl border-l border-border/50 shadow-2xl transform translate-x-full transition-all duration-300 ease-in-out flex flex-col rounded-l-2xl" id="settingsDrawer">
  <!-- Settings Header -->
  <div class="flex items-center justify-between p-6 border-b border-border/50 rounded-tl-2xl bg-gradient-to-l from-background/50 to-muted/30">
    <h3 class="text-lg font-display font-semibold">Settings</h3>
    <Button variant="ghost" size="icon" id="closeSettings" class="h-8 w-8">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </Button>
  </div>

  <!-- Settings Content -->
  <div class="flex-1 overflow-y-auto p-6 rounded-bl-2xl">
    <!-- Dark Mode Toggle -->
    <div class="flex items-center justify-between">
      <span class="font-medium text-foreground">Dark Mode</span>
      <button id="themeToggle" class="relative inline-flex h-6 w-11 items-center rounded-full bg-muted transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 dark:bg-primary">
        <span class="sr-only">Toggle dark mode</span>
        <span class="toggle-slider inline-block h-4 w-4 transform rounded-full bg-background transition-transform translate-x-1 dark:translate-x-6 shadow-sm"></span>
      </button>
    </div>
  </div>
</aside>

<!-- Bottom Navigation Bar -->
<nav class="fixed bottom-0 left-0 right-0 z-40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 border-t">
  <div class="flex items-center justify-around px-2 py-3 max-w-7xl mx-auto">
    <!-- Home Button -->
    <a href="/" class={`flex flex-col items-center gap-1 p-2 rounded-lg transition-colors ${pageType === 'home' ? 'bg-primary/10 text-primary' : 'hover:bg-accent'}`}>
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="text-xs font-medium">Home</span>
    </a>
    
    <!-- Courses Button -->
    <a href="/courses" class={`flex flex-col items-center gap-1 p-2 rounded-lg transition-colors ${pageType === 'courses' || pageType === 'course' ? 'bg-primary/10 text-primary' : 'hover:bg-accent'}`}>
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      <span class="text-xs font-medium">Courses</span>
    </a>
    
    <!-- Tests Button -->
    <button class="flex flex-col items-center gap-1 p-2 rounded-lg hover:bg-accent transition-colors">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <span class="text-xs font-medium">Tests</span>
    </button>
    
    <!-- Settings Button -->
    <button id="settingsButton" class="flex flex-col items-center gap-1 p-2 rounded-lg hover:bg-accent transition-colors">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span class="text-xs font-medium">Settings</span>
    </button>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Theme management
    const themeToggle = document.getElementById('themeToggle');
    
    // Settings drawer elements
    const settingsButton = document.getElementById('settingsButton');
    const settingsDrawer = document.getElementById('settingsDrawer');
    const settingsOverlay = document.getElementById('settingsOverlay');
    const closeSettings = document.getElementById('closeSettings');
    
    // Load saved theme or default to light
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.classList.toggle('dark', savedTheme === 'dark');
    
    function createThemeTransition(event, newTheme) {
      // Get the button position
      const button = event.currentTarget;
      const rect = button.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      
      // Get all elements that should transition
      const elements = document.querySelectorAll('*');
      const maxDistance = Math.sqrt(window.innerWidth ** 2 + window.innerHeight ** 2);
      
      // Calculate distance and delay for each element
      elements.forEach((element, index) => {
        const elementRect = element.getBoundingClientRect();
        const elementCenterX = elementRect.left + elementRect.width / 2;
        const elementCenterY = elementRect.top + elementRect.height / 2;
        
        // Calculate distance from button center to element center
        const distance = Math.sqrt(
          Math.pow(elementCenterX - centerX, 2) + Math.pow(elementCenterY - centerY, 2)
        );
        
        // Calculate delay based on distance with eased curve - slower start, faster middle, slower end
        const normalizedDistance = distance / maxDistance;
        const easedDelay = normalizedDistance < 0.5 
          ? 2 * normalizedDistance * normalizedDistance 
          : 1 - Math.pow(-2 * normalizedDistance + 2, 3) / 2;
        const delay = easedDelay * 1000; // Max 1000ms delay
        
        // Store original transition
        const originalTransition = element.style.transition;
        
        // Set custom transition with delay
        setTimeout(() => {
          element.style.transition = 'background-color 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), fill 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), stroke 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)';
          
          // Trigger a small visual ripple effect with bounce
          if (element === button) {
            element.style.transform = 'scale(1.05)';
            element.style.transition = 'transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55)';
            setTimeout(() => {
              element.style.transform = '';
            }, 300);
          }
          
          // Reset transition after animation
          setTimeout(() => {
            element.style.transition = originalTransition;
          }, 600);
        }, delay);
      });
    }
    
    themeToggle?.addEventListener('click', function(e) {
      const isDark = document.documentElement.classList.contains('dark');
      const newTheme = isDark ? 'light' : 'dark';
      
      // Create animated transition
      createThemeTransition(e, newTheme);
      
      // Update theme immediately so colors can transition naturally
      document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', newTheme);
    });

    // Settings drawer functionality
    function openSettings() {
      settingsDrawer?.classList.remove('translate-x-full');
      settingsOverlay?.classList.remove('opacity-0', 'invisible');
      document.body.style.overflow = 'hidden';
    }

    function closeSettingsFunc() {
      settingsDrawer?.classList.add('translate-x-full');
      settingsOverlay?.classList.add('opacity-0', 'invisible');
      document.body.style.overflow = '';
    }

    settingsButton?.addEventListener('click', openSettings);
    closeSettings?.addEventListener('click', closeSettingsFunc);
    settingsOverlay?.addEventListener('click', closeSettingsFunc);
  });
</script>