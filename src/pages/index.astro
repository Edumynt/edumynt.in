---
import { getCollection } from 'astro:content';
import Navigation from '../components/Navigation.astro';
import Head from '../components/Head.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import '../styles/global.css';

const courses = await getCollection('courses');

// Group courses by course name
const courseGroups = courses.reduce((acc, course) => {
  const courseName = course.data.course;
  if (!acc[courseName]) {
    acc[courseName] = [];
  }
  acc[courseName].push(course);
  return acc;
}, {});

// Get unique courses with their metadata
const uniqueCourses = Object.entries(courseGroups).map(([courseName, lessons]) => {
  const firstLesson = lessons[0];
  const lessonCount = lessons.length;
  const chapters = [...new Set(lessons.map(lesson => lesson.data.chapter).filter(Boolean))];
  
  return {
    name: courseName,
    slug: courseName.toLowerCase().replace(/\s+/g, '-'),
    description: firstLesson.data.description || `Master ${courseName} with our comprehensive course`,
    lessonCount,
    chapterCount: chapters.length,
  };
});
---

<html lang="en">
  <Head 
    title="Edumynt - Literature Courses"
    description="Access our comprehensive literature courses - start learning today."
  />
  <body class="min-h-screen flex flex-col">
    <Navigation pageType="home" />

    <!-- Main Content -->
    <main class="flex-1 p-6 pb-20">
      <div class="mx-auto max-w-7xl">
        <!-- Simple Header -->
        <div class="mb-8">
          <h1 class="text-3xl font-bold text-foreground mb-2">Courses</h1>
          <p class="text-muted-foreground">Choose a course to start learning</p>
        </div>
        
        <!-- Compact Courses Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {uniqueCourses.map((course) => (
            <a 
              href={`/courses/${course.slug}`}
              class="group block p-4 bg-card border border-border rounded-xl hover:border-primary/30 hover:shadow-lg transition-all duration-200 hover:scale-[1.02]"
            >
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                  <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
                
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold text-foreground group-hover:text-primary transition-colors text-sm leading-tight">
                    {course.name}
                  </h3>
                  
                  <div class="flex items-center gap-4 mt-2 text-xs text-muted-foreground">
                    <span class="flex items-center gap-1">
                      <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                      </svg>
                      {course.chapterCount}
                    </span>
                    <span class="flex items-center gap-1">
                      <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                      {course.lessonCount}
                    </span>
                  </div>
                </div>

                <div class="flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
                  <svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </main>
    
    <script>
      // Import and register PWA
      import('/src/lib/pwa.ts');
    </script>
  </body>
</html>