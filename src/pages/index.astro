---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import CourseCard from '../components/course/CourseCard.astro';
import ContinueLearning from '../components/course/ContinueLearning.astro';
import { getCourseOutlines } from '../lib/course-data';

const outlines = await getCourseOutlines();
const recentPublished = outlines.slice(0, 3);

const title = 'Literature Courses';
const description = 'Access our comprehensive literature courses - start learning today.';
---

<BaseLayout title={title} description={description}>
  <Navigation pageType="home" title="Edumynt" />

  <main class="flex-1 px-4 py-6 pb-24 sm:px-6 sm:pb-12 lg:px-8">
    <div class="mx-auto max-w-6xl space-y-8">
      <ContinueLearning />

      <section>
        <h1 class="sr-only">Recently accessed courses</h1>
        <p class="ty-caption mb-3">Recent</p>

        <div id="recentCoursesGrid" class="flex snap-x gap-5 overflow-x-auto pb-2">
          {outlines.map(outline => (
            <article class="hidden min-w-[85%] snap-start sm:min-w-[calc(50%-0.625rem)] lg:min-w-[calc(33.333%-0.875rem)]" data-recent-course-card data-course-id={outline.courseId}>
              <CourseCard outline={outline} compact />
            </article>
          ))}
        </div>
        <div id="recentCoursesEmpty" class="rounded-2xl border border-dashed border-border p-8 text-center text-sm text-muted-foreground">
          Open a course once and it will appear here.
        </div>
      </section>

      <section>
        <h2 class="sr-only">Recently published courses</h2>
        <p class="ty-caption mb-3">New</p>

        <div class="flex snap-x gap-5 overflow-x-auto pb-2">
          {recentPublished.map(outline => (
            <div class="min-w-[85%] snap-start sm:min-w-[calc(50%-0.625rem)] lg:min-w-[calc(33.333%-0.875rem)]">
              <CourseCard outline={outline} compact />
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const cards = Array.from(document.querySelectorAll('[data-recent-course-card]'));
      const empty = document.getElementById('recentCoursesEmpty');

      try {
        const explicitRecent = JSON.parse(localStorage.getItem('edumynt_recent_courses') || '[]');
        const progress = JSON.parse(localStorage.getItem('edumynt_course_progress') || '{}');
        const progressCourse = progress.lastVisitedCourse?.courseSlug
          ? [{ id: progress.lastVisitedCourse.courseSlug }]
          : [];
        const recentIds = [...explicitRecent, ...progressCourse]
          .map(item => item.id)
          .filter(Boolean);
        const uniqueIds = [...new Set(recentIds)].slice(0, 3);

        let shown = 0;
        cards.forEach(card => {
          if (!(card instanceof HTMLElement)) return;
          const index = uniqueIds.indexOf(card.dataset.courseId || '');
          if (index === -1) {
            card.classList.add('hidden');
            return;
          }

          card.style.order = String(index);
          card.classList.remove('hidden');
          shown += 1;
        });

        empty?.classList.toggle('hidden', shown > 0);
      } catch {
        localStorage.removeItem('edumynt_recent_courses');
        empty?.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
