---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ContinueLearning from '../components/course/ContinueLearning.astro';
import CourseCarousel from '../components/course/CourseCarousel.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { getCourseOutlines } from '../lib/course-data';

const outlines = await getCourseOutlines();
const chapterCount = outlines.reduce((total, outline) => total + outline.stats.chapterCount, 0);
const lessonCount = outlines.reduce((total, outline) => total + outline.stats.lessonCount, 0);

const title = 'Literature Courses';
const description = 'Access our comprehensive literature courses - start learning today.';
---

<BaseLayout title={title} description={description}>
  <Navigation pageType="home" />

  <main class="flex-1 px-4 py-6 pb-24 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <PageHeader
        eyebrow="Edumynt"
        title="Structured literature learning for serious exam preparation"
        description="Study courses through ordered chapters and lessons, then resume from your last reading point."
        stats={[
          { label: 'Courses', value: outlines.length },
          { label: 'Chapters', value: chapterCount },
          { label: 'Lessons', value: lessonCount },
        ]}
      />

      <ContinueLearning />
      <CourseCarousel outlines={outlines} />
    </div>
  </main>
</BaseLayout>
