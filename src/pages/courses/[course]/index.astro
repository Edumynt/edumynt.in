---
import { getCollection } from 'astro:content';
import Head from '../../../components/Head.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import '../../../styles/global.css';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  
  // Group by course name
  const courseGroups = courses.reduce((acc, course) => {
    const courseName = course.data.course;
    if (!acc[courseName]) {
      acc[courseName] = [];
    }
    acc[courseName].push(course);
    return acc;
  }, {});

  return Object.keys(courseGroups).map(courseName => ({
    params: { 
      course: courseName.toLowerCase().replace(/\s+/g, '-') 
    },
    props: { 
      courseName,
      lessons: courseGroups[courseName]
    }
  }));
}

const { course } = Astro.params;
const { courseName, lessons } = Astro.props;

// Helper functions to clean display names
function cleanDisplayName(folderName) {
  // Remove number prefix and hyphens, capitalize properly
  return folderName
    .replace(/^\d+-/, '') // Remove number prefix like "1-", "2-", etc.
    .replace(/-/g, ' ') // Replace hyphens with spaces
    .replace(/\b\w/g, l => l.toUpperCase()); // Capitalize first letter of each word
}

function cleanLessonTitle(title) {
  // Clean lesson titles by removing hyphens/underscores and capitalizing properly
  return title
    .replace(/[-_]/g, ' ') // Replace hyphens and underscores with spaces
    .replace(/\b\w/g, l => l.toUpperCase()); // Capitalize first letter of each word
}

// Group lessons by path structure for unlimited nesting
function buildPathHierarchy(lessons) {
  const hierarchy = {};
  
  console.log('Building hierarchy for lessons:', lessons.map(l => l.slug));
  
  lessons.forEach(lesson => {
    const pathParts = lesson.slug.split('/').slice(1); // Remove course name
    const fileName = pathParts[pathParts.length - 1];
    const folders = pathParts.slice(0, -1);
    
    console.log(`Processing ${lesson.slug}: pathParts=${pathParts}, folders=${folders}, fileName=${fileName}`);
    
    let current = hierarchy;
    let fullPath = '';
    
    // Navigate/create folder structure
    folders.forEach((folder, index) => {
      fullPath += (index === 0 ? '' : '/') + folder;
      if (!current[folder]) {
        current[folder] = { 
          _folders: {}, 
          _files: [], 
          _path: fullPath,
          _name: folder 
        };
        console.log(`Created folder structure for: ${folder} at path: ${fullPath}`);
      }
      current = current[folder];
    });
    
    // Add file to the current folder level
    if (folders.length === 0) {
      // Root level file
      if (!current._files) current._files = [];
      current._files.push(lesson);
      console.log(`Added ${lesson.data.title} to root level`);
    } else {
      // File in a folder
      current._files.push(lesson);
      console.log(`Added ${lesson.data.title} to folder: ${folders.join('/')}`);
    }
  });
  
  console.log('Final hierarchy:', hierarchy);
  return hierarchy;
}

const courseHierarchy = buildPathHierarchy(lessons);

// Recursive function to render hierarchy
function renderHierarchy(hierarchy, depth = 0) {
  let sections = [];
  
  console.log(`[Depth ${depth}] Processing hierarchy:`, Object.keys(hierarchy));
  
  // Skip root level files - don't display them
  
  // Handle all folder sections with alphabetical sorting
  const sortedEntries = Object.entries(hierarchy)
    .filter(([key]) => key !== '_files' && key !== '_folders' && key !== '_path' && key !== '_name')
    .sort(([a], [b]) => {
      // Sort alphabetically by folder name (0-introduction, 1-renaissance, etc.)
      return a.localeCompare(b);
    });
  
  sortedEntries.forEach(([key, value]) => {
    console.log(`[Depth ${depth}] Processing key: ${key}`);
    
    // Folder section
    const folderData = value;
    console.log(`[Depth ${depth}] Folder ${key}:`, {
      files: folderData._files?.length || 0,
      subfolders: Object.keys(folderData._folders || {})
    });
    
    const subsections = renderHierarchy(folderData._folders, depth + 1);
    const hasFiles = (folderData._files || []).length > 0;
    const hasSubfolders = Object.keys(folderData._folders || {}).length > 0;
    
    console.log(`[Depth ${depth}] Folder ${key} - hasFiles: ${hasFiles}, hasSubfolders: ${hasSubfolders}, subsections: ${subsections.length}`);
    
    // Show folder if it has files OR if it has subfolders (regardless of whether subsections are returned)
    if (hasFiles || hasSubfolders) {
      const section = {
        name: cleanDisplayName(key),
        isRoot: false,
        depth: depth,
        lessons: (folderData._files || []).sort((a, b) => (a.data.order || 0) - (b.data.order || 0)),
        subsections: subsections
      };
      sections.push(section);
      console.log(`[Depth ${depth}] Added section: ${section.name}`);
    } else {
      console.log(`[Depth ${depth}] Skipped folder: ${key}`);
    }
  });
  
  console.log(`[Depth ${depth}] Returning ${sections.length} sections:`, sections.map(s => s.name));
  return sections;
}

// Helper function to generate lesson URL
function generateLessonUrl(lesson, courseSlug) {
  const pathParts = lesson.slug.split('/').slice(1); // Remove course name
  return `/courses/${courseSlug}/${pathParts.join('/')}`;
}

const hierarchySections = renderHierarchy(courseHierarchy);
const allSections = hierarchySections;

// Count total sections
const totalSections = allSections.length;

const firstLesson = lessons[0];
---

<html lang="en">
  <Head 
    title={`${courseName} - Edumynt`}
    description={`Learn ${courseName} - ${totalSections} sections, ${lessons.length} lessons.`}
  />
  <body class="min-h-screen bg-background text-foreground">
    <!-- App Bar -->
    <header id="app-bar" class="sticky top-0 left-0 right-0 z-50 bg-background/95 backdrop-blur-md border-b border-border">
      <div class="flex items-center justify-between px-4 py-3">
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <button 
            onclick="window.history.back()" 
            class="flex items-center justify-center w-9 h-9 rounded-full hover:bg-muted/80 transition-colors flex-shrink-0"
          >
            <svg class="w-4 h-4 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <div class="w-8 h-8 bg-primary/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <h1 class="font-semibold text-foreground text-sm md:text-base truncate">
                {courseName}
              </h1>
              <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span>{totalSections} chapters</span>
                <span>•</span>
                <span>{lessons.length} lessons</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1 pt-[73px] pb-20">
      <div class="px-6">
        <!-- Course Header with Image -->
        <div class="mb-8 bg-card border border-border rounded-xl overflow-hidden shadow-sm">
          <div class="relative h-48 md:h-64">
            <img 
              src="/images/course_placeholder.jpg" 
              alt={`${courseName} course cover`}
              class="w-full h-full object-cover"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
            />
            <!-- Fallback gradient background -->
            <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-primary/10 to-primary/5 flex items-center justify-center" style="display: none;">
              <div class="w-20 h-20 bg-primary/20 rounded-full flex items-center justify-center">
                <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
            </div>
            <!-- Overlay with course info -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/50 to-transparent">
              <!-- Course chip - Top Left -->
              <div class="absolute top-4 left-4">
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-white/20 text-white border border-white/30 backdrop-blur-sm">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                  Course
                </span>
              </div>
              
              <!-- Title and Stats - Bottom Left -->
              <div class="absolute bottom-4 left-4">
                <!-- Course Title -->
                <h1 class="text-2xl md:text-3xl font-bold text-white mb-3">{courseName}</h1>
                
                <!-- Stats -->
                <div class="flex flex-wrap gap-2">
                  <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-white/20 text-white border border-white/30 backdrop-blur-sm">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    {totalSections} chapters
                  </span>
                  <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-white/20 text-white border border-white/30 backdrop-blur-sm">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    {lessons.length} lessons
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Course Content -->
        <div class="space-y-6">
          {allSections.map((section, index) => (
            <!-- Chapter with lessons -->
            <div class="bg-card border-2 border-border rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-200">
              <button 
                class="w-full text-left p-6 flex items-center justify-between hover:bg-muted/20 transition-colors chapter-toggle group border-b border-border"
                data-target={`section-${index}`}
                data-is-introduction={section.name === 'Introduction' ? 'true' : 'false'}
              >
                <div class="flex items-center gap-4">
                  <div class={`flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center font-bold text-base transition-all duration-200 ${
                    section.name === 'Introduction' 
                      ? 'bg-primary/20 text-primary border-2 border-primary/30' 
                      : 'bg-muted text-muted-foreground border-2 border-border group-hover:bg-primary group-hover:text-primary-foreground group-hover:border-primary'
                  }`}>
                    {section.name === 'Introduction' ? (
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    ) : (
                      <span class="text-lg">{index}</span>
                    )}
                  </div>
                  <div class="flex-1">
                    <h2 class={`font-bold transition-colors text-lg mb-1 ${
                      section.name === 'Introduction' 
                        ? 'text-primary' 
                        : 'text-foreground group-hover:text-primary'
                    }`}>
                      {section.name === 'Introduction' ? '📚 ' : ''}{section.name}
                    </h2>
                    <div class="flex items-center gap-4 text-sm text-muted-foreground">
                      <span class="flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        {section.lessons?.length || 0} lessons
                      </span>
                      {section.subsections?.length > 0 && (
                        <span class="flex items-center gap-1">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                          </svg>
                          {section.subsections.length} sections
                        </span>
                      )}
                      {section.name === 'Introduction' && (
                        <span class="flex items-center gap-1 text-primary">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                          Start here
                        </span>
                      )}
                    </div>
                  </div>
                </div>
                <svg class="h-6 w-6 text-muted-foreground transition-transform duration-300 toggle-icon group-hover:text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              
              <div class="section-content overflow-hidden transition-all duration-300 max-h-0" id={`section-${index}`}>
                {section.lessons && section.lessons.length > 0 && (
                  <div class={`border-t-2 ${
                    section.name === 'Introduction' ? 'bg-primary/5 border-primary/20' : 'bg-muted/5 border-border'
                  }`}>
                    {section.lessons.map((lesson, lessonIndex) => (
                      <a 
                        href={generateLessonUrl(lesson, course)} 
                        class="flex items-center gap-4 p-5 hover:bg-primary/10 transition-all duration-200 group border-b border-border/50 last:border-b-0 hover:border-primary/30"
                      >
                        <div class="flex-shrink-0 w-10 h-10 bg-gradient-to-br from-primary/20 to-primary/10 rounded-lg text-sm font-bold text-primary transition-all duration-200 flex items-center justify-center border border-primary/20 lesson-indicator" data-lesson-slug={generateLessonUrl(lesson, course).split('/').slice(3).join('/')}>
                          <span class="lesson-number">{lessonIndex + 1}</span>
                          <svg class="lesson-checkmark w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                        </div>
                        <div class="flex-1">
                          <span class="text-base text-foreground font-semibold group-hover:text-primary transition-colors block mb-1">
                            {cleanLessonTitle(lesson.data.title)}
                          </span>
                        </div>
                        <div class="flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
                          <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                          </svg>
                        </div>
                      </a>
                    ))}
                  </div>
                )}
                
                {section.subsections && section.subsections.length > 0 && (
                  <div class="border-t">
                    {section.subsections.map((subsection, subIndex) => (
                      <div>
                        <button 
                          class="w-full text-left p-4 pl-8 flex items-center justify-between hover:bg-muted/30 transition-colors bg-muted/10 border-b chapter-toggle group"
                          data-target={`subsection-${index}-${subIndex}`}
                        >
                          <div class="flex items-center gap-3">
                            <div class="w-6 h-6 bg-primary/5 rounded text-xs font-medium text-primary/70 flex items-center justify-center">
                              {subIndex + 1}
                            </div>
                            <div>
                              <h3 class="text-sm font-medium text-foreground group-hover:text-primary transition-colors">
                                {cleanDisplayName(subsection.name)}
                              </h3>
                              <p class="text-xs text-muted-foreground mt-0.5">
                                {subsection.lessons?.length || 0} lessons
                              </p>
                            </div>
                          </div>
                          <svg class="h-4 w-4 text-muted-foreground transition-transform duration-300 toggle-icon group-hover:text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                          </svg>
                        </button>
                        
                        <div class="section-content overflow-hidden transition-all duration-300 max-h-0" id={`subsection-${index}-${subIndex}`}>
                          {subsection.lessons && subsection.lessons.length > 0 && (
                            <div class="bg-muted/8">
                              {subsection.lessons.map((lesson, lessonIndex) => (
                                <a 
                                  href={generateLessonUrl(lesson, course)} 
                                  class="flex items-center gap-4 p-4 pl-12 hover:bg-primary/5 transition-all duration-200 group border-b last:border-b-0 hover:border-primary/20"
                                >
                                  <div class="flex-shrink-0 w-6 h-6 bg-primary/10 rounded text-xs font-semibold text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-all duration-200 flex items-center justify-center">
                                    {lessonIndex + 1}
                                  </div>
                                  <div class="flex-1">
                                    <span class="text-sm text-foreground font-medium group-hover:text-primary transition-colors block">
                                      {cleanLessonTitle(lesson.data.title)}
                                    </span>
                                  </div>
                                  <div class="flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                    </svg>
                                  </div>
                                </a>
                              ))}
                            </div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const toggleButtons = document.querySelectorAll('.chapter-toggle');
        
        // Course Progress Tracking System
        class CourseProgressTracker {
          constructor() {
            this.storageKey = 'edumynt_course_progress';
          }
          
          getProgress() {
            try {
              const stored = localStorage.getItem(this.storageKey);
              return stored ? JSON.parse(stored) : {};
            } catch (e) {
              console.warn('Failed to load course progress:', e);
              return {};
            }
          }
          
          getCourseProgress(courseSlug) {
            const progress = this.getProgress();
            return progress.courseProgress?.[courseSlug] || null;
          }
          
          getLastVisitedCourse() {
            const progress = this.getProgress();
            return progress.lastVisitedCourse || null;
          }
        }
        
        // Initialize progress tracker
        const tracker = new CourseProgressTracker();
        
        // Auto-scroll functionality
        function handleAutoScroll() {
          const urlParams = new URLSearchParams(window.location.search);
          const shouldContinue = urlParams.get('continue') === 'true';
          
          if (!shouldContinue) return;
          
          const currentCourse = window.location.pathname.split('/')[2]; // /courses/[course]/
          const lastVisited = tracker.getLastVisitedCourse();
          
          if (!lastVisited || lastVisited.courseSlug !== currentCourse) {
            console.warn('No matching last visited course found');
            return;
          }
          
          console.log('Auto-scrolling to lesson:', lastVisited.lessonSlug);
          
          // Find the lesson link to scroll to
          const targetLessonUrl = `/courses/${lastVisited.courseSlug}/${lastVisited.lessonSlug}`;
          const lessonLinks = document.querySelectorAll('a[href]');
          let targetLink = null;
          
          lessonLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href === targetLessonUrl) {
              targetLink = link;
            }
          });
          
          if (!targetLink) {
            console.warn('Could not find lesson link to scroll to:', targetLessonUrl);
            console.log('Available lesson links:', Array.from(lessonLinks).map(l => l.getAttribute('href')));
            return;
          }
          
          console.log('Found target link:', targetLink);
          
          // Expand parent sections if needed
          function expandParentSections(element) {
            let current = element.parentElement;
            
            while (current && current !== document.body) {
              if (current.classList?.contains('section-content')) {
                const toggleButton = document.querySelector(`[data-target="${current.id}"]`);
                if (toggleButton) {
                  const icon = toggleButton.querySelector('.toggle-icon');
                  current.style.maxHeight = current.scrollHeight + 'px';
                  if (icon) icon.style.transform = 'rotate(180deg)';
                  console.log('Expanded section:', current.id);
                }
              }
              current = current.parentElement;
            }
          }
          
          // Expand sections containing the target lesson
          expandParentSections(targetLink);
          
          // Scroll to the lesson with a delay to allow expansions to complete
          setTimeout(() => {
            // Double-check if sections need re-expansion after DOM updates
            const targetRect = targetLink.getBoundingClientRect();
            if (targetRect.height === 0) {
              console.log('Target not visible, re-expanding sections');
              expandParentSections(targetLink);
              
              setTimeout(() => {
                performScroll();
              }, 200);
            } else {
              performScroll();
            }
          }, 300);
          
          function performScroll() {
            targetLink.scrollIntoView({ 
              behavior: 'smooth', 
              block: 'center' 
            });
            
            console.log('Scrolled to target lesson');
            
            // Add highlight effect
            targetLink.style.background = 'rgba(var(--primary), 0.1)';
            targetLink.style.transform = 'scale(1.02)';
            targetLink.style.transition = 'all 0.3s ease';
            targetLink.style.boxShadow = '0 0 0 2px rgba(var(--primary), 0.2)';
            targetLink.style.borderRadius = '8px';
            
            // Remove highlight after 3 seconds
            setTimeout(() => {
              targetLink.style.background = '';
              targetLink.style.transform = '';
              targetLink.style.boxShadow = '';
            }, 3000);
            
            // Remove continue parameter from URL
            const newUrl = window.location.pathname;
            window.history.replaceState({}, '', newUrl);
          }
        }
        
        // Add visual progress indicators
        function addProgressIndicators() {
          const currentCourse = window.location.pathname.split('/')[2];
          const courseProgress = tracker.getCourseProgress(currentCourse);
          
          if (!courseProgress || !courseProgress.visitedLessons) return;
          
          const visitedSlugs = courseProgress.visitedLessons.map(lesson => lesson.slug);
          
          // Update lesson indicators
          const lessonIndicators = document.querySelectorAll('.lesson-indicator');
          lessonIndicators.forEach(indicator => {
            const lessonSlug = indicator.getAttribute('data-lesson-slug');
            const numberElement = indicator.querySelector('.lesson-number');
            const checkmarkElement = indicator.querySelector('.lesson-checkmark');
            
            if (visitedSlugs.includes(lessonSlug)) {
              // Show checkmark, hide number
              numberElement.classList.add('hidden');
              checkmarkElement.classList.remove('hidden');
              indicator.classList.add('bg-primary', 'text-primary-foreground', 'border-primary');
              indicator.classList.remove('bg-gradient-to-br', 'from-primary/20', 'to-primary/10', 'text-primary', 'border-primary/20');
            }
          });
        }
        
        // Toggle button functionality
        toggleButtons.forEach(button => {
          button.addEventListener('click', function() {
            const targetId = this.getAttribute('data-target');
            const content = document.getElementById(targetId);
            const icon = this.querySelector('.toggle-icon');
            
            if (content && icon) {
              const isExpanded = content.style.maxHeight && content.style.maxHeight !== '0px';
              
              if (isExpanded) {
                // Collapse
                content.style.maxHeight = '0px';
                icon.style.transform = 'rotate(0deg)';
              } else {
                // Expand
                content.style.maxHeight = content.scrollHeight + 'px';
                icon.style.transform = 'rotate(180deg)';
              }
            }
          });
        });
        
        // Smart expansion logic
        function initializeExpansion() {
          const currentCourse = window.location.pathname.split('/')[2];
          const tracker = new CourseProgressTracker();
          const lastVisited = tracker.getLastVisitedCourse();
          
          // Check if user has visited this course before
          const hasVisitedCourse = lastVisited && lastVisited.courseSlug === currentCourse;
          
          if (hasVisitedCourse) {
            // Expand last visited section and scroll to it
            const urlParams = new URLSearchParams(window.location.search);
            const shouldContinue = urlParams.get('continue') === 'true';
            
            if (shouldContinue) {
              handleAutoScroll();
            } else {
              // Find and expand the section containing the last visited lesson
              const targetLessonUrl = `/courses/${lastVisited.courseSlug}/${lastVisited.lessonSlug}`;
              const lessonLinks = document.querySelectorAll('a[href]');
              
              lessonLinks.forEach(link => {
                if (link.getAttribute('href') === targetLessonUrl) {
                  const sectionContainer = link.closest('.section-content');
                  if (sectionContainer) {
                    const toggleButton = document.querySelector(`[data-target="${sectionContainer.id}"]`);
                    if (toggleButton) {
                      const icon = toggleButton.querySelector('.toggle-icon');
                      sectionContainer.style.maxHeight = sectionContainer.scrollHeight + 'px';
                      if (icon) icon.style.transform = 'rotate(180deg)';
                      
                      // Scroll to the section
                      setTimeout(() => {
                        sectionContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                      }, 300);
                    }
                  }
                }
              });
            }
          } else {
            // First time visiting - expand Introduction section (0-introduction)
            const introButton = document.querySelector('[data-is-introduction="true"]');
            if (introButton) {
              const targetId = introButton.getAttribute('data-target');
              const content = document.getElementById(targetId);
              const icon = introButton.querySelector('.toggle-icon');
              
              if (content && icon) {
                content.style.maxHeight = content.scrollHeight + 'px';
                icon.style.transform = 'rotate(180deg)';
              }
            }
          }
        }
        
        // Initialize features
        handleAutoScroll();
        addProgressIndicators();
        initializeExpansion();
      });
    </script>
  </body>
</html>