---
import { getCollection } from 'astro:content';
import Navigation from '../../../components/Navigation.astro';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  
  // Group by course name
  const courseGroups = courses.reduce((acc, course) => {
    const courseName = course.data.course;
    if (!acc[courseName]) {
      acc[courseName] = [];
    }
    acc[courseName].push(course);
    return acc;
  }, {});

  return Object.keys(courseGroups).map(courseName => ({
    params: { 
      course: courseName.toLowerCase().replace(/\s+/g, '-') 
    },
    props: { 
      courseName,
      lessons: courseGroups[courseName]
    }
  }));
}

const { course } = Astro.params;
const { courseName, lessons } = Astro.props;

// Group lessons by path structure for unlimited nesting
function buildPathHierarchy(lessons) {
  const hierarchy = {};
  
  console.log('Building hierarchy for lessons:', lessons.map(l => l.slug));
  
  lessons.forEach(lesson => {
    const pathParts = lesson.slug.split('/').slice(1); // Remove course name
    const fileName = pathParts[pathParts.length - 1];
    const folders = pathParts.slice(0, -1);
    
    console.log(`Processing ${lesson.slug}: pathParts=${pathParts}, folders=${folders}, fileName=${fileName}`);
    
    let current = hierarchy;
    let fullPath = '';
    
    // Navigate/create folder structure
    folders.forEach((folder, index) => {
      fullPath += (index === 0 ? '' : '/') + folder;
      if (!current[folder]) {
        current[folder] = { 
          _folders: {}, 
          _files: [], 
          _path: fullPath,
          _name: folder 
        };
        console.log(`Created folder structure for: ${folder} at path: ${fullPath}`);
      }
      current = current[folder];
    });
    
    // Add file to the current folder level
    if (folders.length === 0) {
      // Root level file
      if (!current._files) current._files = [];
      current._files.push(lesson);
      console.log(`Added ${lesson.data.title} to root level`);
    } else {
      // File in a folder
      current._files.push(lesson);
      console.log(`Added ${lesson.data.title} to folder: ${folders.join('/')}`);
    }
  });
  
  console.log('Final hierarchy:', hierarchy);
  return hierarchy;
}

const courseHierarchy = buildPathHierarchy(lessons);

// Recursive function to render hierarchy
function renderHierarchy(hierarchy, depth = 0) {
  let sections = [];
  
  console.log(`[Depth ${depth}] Processing hierarchy:`, Object.keys(hierarchy));
  
  Object.entries(hierarchy).forEach(([key, value]) => {
    console.log(`[Depth ${depth}] Processing key: ${key}`);
    
    if (key === '_files' && value.length > 0) {
      // Root level files
      if (depth === 0) {
        console.log(`[Depth ${depth}] Adding root level files: ${value.length}`);
        sections.push({
          name: 'Course Files',
          isRoot: true,
          lessons: value.sort((a, b) => (a.data.order || 0) - (b.data.order || 0)),
          subsections: []
        });
      }
    } else if (key !== '_files' && key !== '_folders' && key !== '_path' && key !== '_name') {
      // Folder section
      const folderData = value;
      console.log(`[Depth ${depth}] Folder ${key}:`, {
        files: folderData._files?.length || 0,
        subfolders: Object.keys(folderData._folders || {})
      });
      
      const subsections = renderHierarchy(folderData._folders, depth + 1);
      const hasFiles = (folderData._files || []).length > 0;
      const hasSubfolders = Object.keys(folderData._folders || {}).length > 0;
      
      console.log(`[Depth ${depth}] Folder ${key} - hasFiles: ${hasFiles}, hasSubfolders: ${hasSubfolders}, subsections: ${subsections.length}`);
      
      // Show folder if it has files OR if it has subfolders (regardless of whether subsections are returned)
      if (hasFiles || hasSubfolders) {
        const section = {
          name: key.charAt(0).toUpperCase() + key.slice(1).replace(/-/g, ' '),
          isRoot: false,
          depth: depth,
          lessons: (folderData._files || []).sort((a, b) => (a.data.order || 0) - (b.data.order || 0)),
          subsections: subsections
        };
        sections.push(section);
        console.log(`[Depth ${depth}] Added section: ${section.name}`);
      } else {
        console.log(`[Depth ${depth}] Skipped folder: ${key}`);
      }
    }
  });
  
  console.log(`[Depth ${depth}] Returning ${sections.length} sections:`, sections.map(s => s.name));
  return sections;
}

// Helper function to generate lesson URL
function generateLessonUrl(lesson, courseSlug) {
  const pathParts = lesson.slug.split('/').slice(1); // Remove course name
  return `/courses/${courseSlug}/${pathParts.join('/')}`;
}

const hierarchySections = renderHierarchy(courseHierarchy);

const firstLesson = lessons[0];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />
    <title>{courseName} - Course Overview</title>
    <meta name="description" content={`Learn ${courseName} with our comprehensive course featuring ${hierarchySections.length} sections and ${lessons.length} lessons.`} />
  </head>
  <body>
    <Navigation pageType="course" currentCourse={course} />

    <nav class="breadcrumb">
      <a href="/courses">← All Courses</a>
    </nav>

    <main class="container">
      <header class="course-header">
        <h1>{courseName}</h1>
        <p>{firstLesson?.data.description || `Complete course on ${courseName}`}</p>
        <div class="course-stats">
          <span>{hierarchySections.length} sections</span>
          <span>{lessons.length} lessons</span>
        </div>
      </header>

      <div class="chapters-list">
        {hierarchySections.map((section, index) => (
          <section class="chapter">
            <div class="chapter-header">
              <h2 class="chapter-title" data-section={`section-${index}`}>
                {section.isRoot 
                  ? "Course Files" 
                  : section.name
                }
                {(section.lessons.length > 0 || (section.subsections && section.subsections.length > 0)) && (
                  <span class="toggle-icon" id={`toggle-section-${index}`}>▼</span>
                )}
              </h2>
            </div>
            <div class="chapter-content" id={`section-${index}`}>
              {section.lessons && section.lessons.length > 0 && (
                <ul class="lessons-list">
                  {section.lessons.map((lesson, lessonIndex) => {
                    const linkUrl = generateLessonUrl(lesson, course);
                    
                    return (
                      <li class="lesson-item">
                        <a href={linkUrl}>
                          <span class="lesson-number">{lessonIndex + 1}</span>
                          <span class="lesson-title">{lesson.data.title}</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )}
              {section.subsections && section.subsections.length > 0 && (
                <div class="subsections">
                  {section.subsections.map((subsection, subIndex) => (
                    <div class="subsection">
                      <div class="subsection-header">
                        <h3 class="subsection-title" data-section={`subsection-${index}-${subIndex}`}>
                          {subsection.name}
                          <span class="toggle-icon" id={`toggle-subsection-${index}-${subIndex}`}>▼</span>
                        </h3>
                      </div>
                      <div class="subsection-content" id={`subsection-${index}-${subIndex}`}>
                        {subsection.lessons && subsection.lessons.length > 0 && (
                          <ul class="lessons-list">
                            {subsection.lessons.map((lesson, lessonIndex) => {
                              const linkUrl = generateLessonUrl(lesson, course);
                              
                              return (
                                <li class="lesson-item">
                                  <a href={linkUrl}>
                                    <span class="lesson-number">{lessonIndex + 1}</span>
                                    <span class="lesson-title">{lesson.data.title}</span>
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </section>
        ))}
      </div>
    </main>

    <style>
      :root {
        --bg-color: #f8fafc;
        --text-color: #1a1a1a;
        --card-bg: white;
        --border-color: #e5e7eb;
        --accent-color: #667eea;
        --hover-bg: #f3f4f6;
      }

      :root[data-theme="dark"] {
        --bg-color: #0f172a;
        --text-color: #f1f5f9;
        --card-bg: #1e293b;
        --border-color: #334155;
        --accent-color: #818cf8;
        --hover-bg: #334155;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: var(--text-color);
        background: var(--bg-color);
        margin: 0;
        padding: 0;
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      .breadcrumb {
        padding: 1rem 2rem;
        background: var(--hover-bg);
        border-bottom: 1px solid var(--border-color);
      }

      .breadcrumb a {
        color: var(--accent-color);
        text-decoration: none;
      }

      .breadcrumb a:hover {
        text-decoration: underline;
      }

      .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
      }

      .course-header {
        text-align: center;
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 2px solid #e5e7eb;
      }

      .course-header h1 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: var(--text-color);
      }

      .course-header p {
        font-size: 1.2rem;
        color: #6b7280;
        margin-bottom: 1rem;
      }

      .course-stats {
        display: flex;
        justify-content: center;
        gap: 2rem;
        font-size: 1rem;
        color: #9ca3af;
      }

      .chapter {
        margin-bottom: 2rem;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
      }

      .chapter-header {
        background: var(--hover-bg);
        border-bottom: 1px solid var(--border-color);
      }

      .chapter-title {
        padding: 1rem 1.5rem;
        margin: 0;
        font-size: 1.3rem;
        color: var(--text-color);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
      }

      .chapter-title:hover {
        background: var(--border-color);
      }

      .toggle-icon {
        transition: transform 0.3s ease;
        font-size: 0.8rem;
        color: #6b7280;
      }

      .toggle-icon.rotated {
        transform: rotate(-90deg);
      }

      .chapter-content {
        overflow: hidden;
        transition: max-height 0.3s ease;
      }

      .chapter-content.collapsed {
        max-height: 0;
      }

      .subsections {
        border-top: 1px solid #f3f4f6;
      }

      .subsection {
        border-bottom: 1px solid #f9fafb;
      }

      .subsection:last-child {
        border-bottom: none;
      }

      .subsection-header {
        background: #f9fafb;
      }

      .subsection-title {
        padding: 0.75rem 2rem;
        margin: 0;
        font-size: 1.1rem;
        color: #4b5563;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
      }

      .subsection-title:hover {
        background: #f3f4f6;
      }

      .subsection-content {
        overflow: hidden;
        transition: max-height 0.3s ease;
      }

      .subsection-content.collapsed {
        max-height: 0;
      }

      .subsection .lessons-list {
        background: white;
      }

      .lessons-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .lesson-item {
        border-bottom: 1px solid #f3f4f6;
      }

      .lesson-item:last-child {
        border-bottom: none;
      }

      .lesson-item a {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        text-decoration: none;
        color: var(--text-color);
        transition: background 0.2s;
      }

      .lesson-item a:hover {
        background: var(--hover-bg);
      }

      .lesson-number {
        background: var(--accent-color);
        color: white;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: bold;
        flex-shrink: 0;
      }

      .lesson-title {
        flex: 1;
        font-weight: 500;
      }

      @media (max-width: 768px) {
        .container {
          padding: 1rem;
        }

        .breadcrumb {
          padding: 0.75rem 1rem;
        }

        .course-header h1 {
          font-size: 2rem;
        }

        .course-header p {
          font-size: 1rem;
        }

        .course-stats {
          flex-direction: column;
          gap: 0.5rem;
        }

        .chapter-title {
          font-size: 1.1rem;
          padding: 0.75rem 1rem;
        }

        .lesson-item a {
          padding: 0.75rem 1rem;
        }
      }
    </style>

    <script>
      function toggleSection(sectionId) {
        const content = document.getElementById(sectionId);
        const toggleIcon = document.getElementById(`toggle-${sectionId}`);
        
        if (content.style.maxHeight && content.style.maxHeight !== '0px') {
          // Collapse
          content.style.maxHeight = '0px';
          content.classList.add('collapsed');
          if (toggleIcon) {
            toggleIcon.classList.add('rotated');
          }
        } else {
          // Expand
          content.style.maxHeight = content.scrollHeight + 'px';
          content.classList.remove('collapsed');
          if (toggleIcon) {
            toggleIcon.classList.remove('rotated');
          }
        }
      }

      // Initialize all sections as expanded and add event listeners
      document.addEventListener('DOMContentLoaded', function() {
        // Initialize content heights
        const allContents = document.querySelectorAll('.chapter-content, .subsection-content');
        allContents.forEach(content => {
          content.style.maxHeight = content.scrollHeight + 'px';
        });

        // Add click event listeners
        const chapterTitles = document.querySelectorAll('.chapter-title[data-section]');
        chapterTitles.forEach(title => {
          title.addEventListener('click', function() {
            const sectionId = this.getAttribute('data-section');
            toggleSection(sectionId);
          });
        });

        const subsectionTitles = document.querySelectorAll('.subsection-title[data-section]');
        subsectionTitles.forEach(title => {
          title.addEventListener('click', function() {
            const sectionId = this.getAttribute('data-section');
            toggleSection(sectionId);
          });
        });
      });
    </script>
  </body>
</html>