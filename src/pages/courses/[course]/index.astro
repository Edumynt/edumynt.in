---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import CourseHero from '../../../components/course/CourseHero.astro';
import Badge from '../../../components/ui/Badge.astro';
import ChapterAccordion from '../../../components/course/ChapterAccordion.astro';
import { getCourseOutlines } from '../../../lib/course-data';

export async function getStaticPaths() {
  const outlines = await getCourseOutlines();

  return outlines.map(outline => ({
    params: { course: outline.courseId },
    props: { outline },
  }));
}

const { outline } = Astro.props;
const { course } = outline;
const { Content } = await render(course);

const title = course.data.title;
const description = course.data.description;
const lessonTypeCounts = outline.lessons.reduce<Record<string, number>>((counts, lesson) => {
  counts[lesson.data.type] = (counts[lesson.data.type] || 0) + 1;
  return counts;
}, {});
const lessonTypes = Object.keys(lessonTypeCounts).sort((a, b) => a.localeCompare(b));
const pluralizeType = (type: string, count: number) => {
  const plural = type === 'quiz' ? 'quizzes' : `${type}s`;
  return `${count} ${count === 1 ? type : plural}`;
};
const typeSummary = lessonTypes.map(type => pluralizeType(type, lessonTypeCounts[type] ?? 0));
---

<BaseLayout title={title} description={description}>
  <div class="lg:ml-64">
    <Navigation pageType="course" title={course.data.title} titleHref={`/courses/${outline.courseId}`} showBottomNav={false} />

    <main class="flex-1 px-4 py-6 pb-14 sm:px-6 sm:pb-16 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <CourseHero outline={outline} />

        <div>
          <div class="min-w-0">
            <div class="mb-6 flex gap-1 overflow-x-auto border-b border-border" role="tablist" aria-label="Course details">
              <button
                id="course-tab-curriculum"
                type="button"
                role="tab"
                aria-selected="true"
                aria-controls="course-panel-curriculum"
                class="whitespace-nowrap border-b-2 border-primary px-3 py-3 text-sm font-bold text-foreground sm:px-4"
                data-course-tab="curriculum"
              >
                Curriculum
              </button>
              <button
                id="course-tab-overview"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="course-panel-overview"
                tabindex="-1"
                class="whitespace-nowrap border-b-2 border-transparent px-3 py-3 text-sm font-bold text-muted-foreground hover:text-foreground sm:px-4"
                data-course-tab="overview"
              >
                Overview
              </button>
            </div>

            <section id="course-panel-curriculum" role="tabpanel" aria-labelledby="course-tab-curriculum" tabindex="0" data-course-panel="curriculum">
              <div class="mb-5">
                <h2 class="ty-title-sm">Chapters and lessons</h2>
                <p class="mt-1 text-sm font-semibold text-muted-foreground">{outline.stats.lessonCount} lessons</p>
              </div>
              <ChapterAccordion chapters={outline.chapters} />
            </section>

            <section id="course-panel-overview" class="hidden space-y-6" role="tabpanel" aria-labelledby="course-tab-overview" tabindex="0" data-course-panel="overview">
              <div>
                <h2 class="mb-3 text-lg font-display font-bold text-foreground">Overview</h2>
                <p class="max-w-3xl text-base leading-relaxed text-muted-foreground">
                  {course.data.longDescription || course.data.description}
                </p>
              </div>

              <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-2 xl:grid-cols-4">
                <div class="rounded-2xl bg-muted p-3 sm:p-4">
                  <div class="text-xs font-semibold text-muted-foreground sm:text-sm">Chapters</div>
                  <div class="text-xl font-display font-bold text-foreground sm:text-2xl">{outline.stats.chapterCount}</div>
                </div>
                <div class="rounded-2xl bg-muted p-3 sm:p-4">
                  <div class="text-xs font-semibold text-muted-foreground sm:text-sm">Lessons</div>
                  <div class="text-xl font-display font-bold text-foreground sm:text-2xl">{outline.stats.lessonCount}</div>
                </div>
                {course.data.duration && (
                  <div class="rounded-2xl bg-muted p-3 sm:p-4">
                    <div class="text-xs font-semibold text-muted-foreground sm:text-sm">Duration</div>
                    <div class="text-base font-display font-bold text-foreground sm:text-lg">{course.data.duration}</div>
                  </div>
                )}
                <div class="rounded-2xl bg-muted p-3 sm:p-4">
                  <div class="text-xs font-semibold text-muted-foreground sm:text-sm">Difficulty</div>
                  <div class="text-base font-display font-bold capitalize text-foreground sm:text-lg">{course.data.difficulty}</div>
                </div>
              </div>

              {course.data.exams.length > 0 && (
                <div>
                  <h2 class="mb-3 text-lg font-display font-bold text-foreground">Exam focus</h2>
                  <div class="flex flex-wrap gap-2">
                    {course.data.exams.map(exam => <Badge tone="primary">{exam}</Badge>)}
                  </div>
                </div>
              )}

              {course.data.learningOutcomes.length > 0 && (
                <div>
                  <h2 class="mb-3 text-lg font-display font-bold text-foreground">Learning outcomes</h2>
                  <ul class="grid gap-2 pl-0 sm:grid-cols-2">
                    {course.data.learningOutcomes.map(outcome => (
                      <li class="rounded-xl bg-muted px-4 py-3 text-sm text-muted-foreground">{outcome}</li>
                    ))}
                  </ul>
                </div>
              )}

              {course.data.prerequisites.length > 0 && (
                <div>
                  <h2 class="mb-3 text-lg font-display font-bold text-foreground">Prerequisites</h2>
                  <div class="flex flex-wrap gap-2">
                    {course.data.prerequisites.map(item => <Badge tone="muted">{item}</Badge>)}
                  </div>
                </div>
              )}

              {typeSummary.length > 0 && (
                <div>
                  <h2 class="mb-3 text-lg font-display font-bold text-foreground">Includes</h2>
                  <div class="flex flex-wrap gap-2">
                    {typeSummary.map(item => <Badge tone="muted">{item}</Badge>)}
                  </div>
                </div>
              )}

              {course.data.tags.length > 0 && (
                <div>
                  <h2 class="mb-3 text-lg font-display font-bold text-foreground">Tags</h2>
                  <div class="flex flex-wrap gap-2">
                    {course.data.tags.map(tag => <Badge tone="muted">{tag}</Badge>)}
                  </div>
                </div>
              )}

              <div class="prose prose-lg max-w-none dark:prose-invert">
                <Content />
              </div>
            </section>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script define:vars={{ courseId: outline.courseId, courseTitle: course.data.title, courseUrl: `/courses/${outline.courseId}` }}>
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = Array.from(document.querySelectorAll('[data-course-tab]'));
      const panels = Array.from(document.querySelectorAll('[data-course-panel]'));

      function activateTab(selected) {
        tabs.forEach(tab => {
          const isActive = tab.getAttribute('data-course-tab') === selected;
          tab.classList.toggle('border-primary', isActive);
          tab.classList.toggle('text-foreground', isActive);
          tab.classList.toggle('border-transparent', !isActive);
          tab.classList.toggle('text-muted-foreground', !isActive);
          tab.setAttribute('aria-selected', String(isActive));
          tab.setAttribute('tabindex', isActive ? '0' : '-1');
        });

        panels.forEach(panel => {
          const isActive = panel.getAttribute('data-course-panel') === selected;
          panel.classList.toggle('hidden', !isActive);
          panel.toggleAttribute('hidden', !isActive);
        });
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          activateTab(tab.getAttribute('data-course-tab'));
        });

        tab.addEventListener('keydown', event => {
          const keys = ['ArrowRight', 'ArrowLeft', 'Home', 'End'];
          if (!keys.includes(event.key)) return;

          event.preventDefault();
          const lastIndex = tabs.length - 1;
          const nextIndex = event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? lastIndex
              : event.key === 'ArrowRight'
                ? index === lastIndex ? 0 : index + 1
                : index === 0 ? lastIndex : index - 1;
          const nextTab = tabs[nextIndex];
          nextTab?.focus();
          activateTab(nextTab?.getAttribute('data-course-tab'));
        });
      });

      activateTab('curriculum');

      try {
        const recent = JSON.parse(localStorage.getItem('edumynt_recent_courses') || '[]');

        const next = [
          { id: courseId, title: courseTitle, url: courseUrl, timestamp: new Date().toISOString() },
          ...recent.filter(item => item.id !== courseId),
        ].slice(0, 6);
        localStorage.setItem('edumynt_recent_courses', JSON.stringify(next));
      } catch {
        localStorage.removeItem('edumynt_recent_courses');
      }
    });
  </script>
</BaseLayout>
