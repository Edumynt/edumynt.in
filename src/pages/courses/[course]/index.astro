---
import { getCollection } from 'astro:content';
import Navigation from '../../../components/Navigation.astro';
import Button from '../../../components/ui/Button.astro';
import Card from '../../../components/ui/Card.astro';
import '../../../styles/global.css';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  
  // Group by course name
  const courseGroups = courses.reduce((acc, course) => {
    const courseName = course.data.course;
    if (!acc[courseName]) {
      acc[courseName] = [];
    }
    acc[courseName].push(course);
    return acc;
  }, {});

  return Object.keys(courseGroups).map(courseName => ({
    params: { 
      course: courseName.toLowerCase().replace(/\s+/g, '-') 
    },
    props: { 
      courseName,
      lessons: courseGroups[courseName]
    }
  }));
}

const { course } = Astro.params;
const { courseName, lessons } = Astro.props;

// Group lessons by path structure for unlimited nesting
function buildPathHierarchy(lessons) {
  const hierarchy = {};
  
  console.log('Building hierarchy for lessons:', lessons.map(l => l.slug));
  
  lessons.forEach(lesson => {
    const pathParts = lesson.slug.split('/').slice(1); // Remove course name
    const fileName = pathParts[pathParts.length - 1];
    const folders = pathParts.slice(0, -1);
    
    console.log(`Processing ${lesson.slug}: pathParts=${pathParts}, folders=${folders}, fileName=${fileName}`);
    
    let current = hierarchy;
    let fullPath = '';
    
    // Navigate/create folder structure
    folders.forEach((folder, index) => {
      fullPath += (index === 0 ? '' : '/') + folder;
      if (!current[folder]) {
        current[folder] = { 
          _folders: {}, 
          _files: [], 
          _path: fullPath,
          _name: folder 
        };
        console.log(`Created folder structure for: ${folder} at path: ${fullPath}`);
      }
      current = current[folder];
    });
    
    // Add file to the current folder level
    if (folders.length === 0) {
      // Root level file
      if (!current._files) current._files = [];
      current._files.push(lesson);
      console.log(`Added ${lesson.data.title} to root level`);
    } else {
      // File in a folder
      current._files.push(lesson);
      console.log(`Added ${lesson.data.title} to folder: ${folders.join('/')}`);
    }
  });
  
  console.log('Final hierarchy:', hierarchy);
  return hierarchy;
}

const courseHierarchy = buildPathHierarchy(lessons);

// Recursive function to render hierarchy
function renderHierarchy(hierarchy, depth = 0) {
  let sections = [];
  
  console.log(`[Depth ${depth}] Processing hierarchy:`, Object.keys(hierarchy));
  
  // First, handle root level files (only at depth 0)
  if (depth === 0 && hierarchy._files && hierarchy._files.length > 0) {
    console.log(`[Depth ${depth}] Adding root level files individually: ${hierarchy._files.length}`);
    const sortedFiles = hierarchy._files.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
    sortedFiles.forEach(lesson => {
      sections.push({
        name: lesson.data.title,
        isRoot: true,
        isIndividualFile: true,
        lessons: [lesson],
        subsections: []
      });
    });
  }
  
  // Then, handle all folder sections
  Object.entries(hierarchy).forEach(([key, value]) => {
    console.log(`[Depth ${depth}] Processing key: ${key}`);
    
    if (key !== '_files' && key !== '_folders' && key !== '_path' && key !== '_name') {
      // Folder section
      const folderData = value;
      console.log(`[Depth ${depth}] Folder ${key}:`, {
        files: folderData._files?.length || 0,
        subfolders: Object.keys(folderData._folders || {})
      });
      
      const subsections = renderHierarchy(folderData._folders, depth + 1);
      const hasFiles = (folderData._files || []).length > 0;
      const hasSubfolders = Object.keys(folderData._folders || {}).length > 0;
      
      console.log(`[Depth ${depth}] Folder ${key} - hasFiles: ${hasFiles}, hasSubfolders: ${hasSubfolders}, subsections: ${subsections.length}`);
      
      // Show folder if it has files OR if it has subfolders (regardless of whether subsections are returned)
      if (hasFiles || hasSubfolders) {
        const section = {
          name: key.charAt(0).toUpperCase() + key.slice(1).replace(/-/g, ' '),
          isRoot: false,
          depth: depth,
          lessons: (folderData._files || []).sort((a, b) => (a.data.order || 0) - (b.data.order || 0)),
          subsections: subsections
        };
        sections.push(section);
        console.log(`[Depth ${depth}] Added section: ${section.name}`);
      } else {
        console.log(`[Depth ${depth}] Skipped folder: ${key}`);
      }
    }
  });
  
  console.log(`[Depth ${depth}] Returning ${sections.length} sections:`, sections.map(s => s.name));
  return sections;
}

// Helper function to generate lesson URL
function generateLessonUrl(lesson, courseSlug) {
  const pathParts = lesson.slug.split('/').slice(1); // Remove course name
  return `/courses/${courseSlug}/${pathParts.join('/')}`;
}

const hierarchySections = renderHierarchy(courseHierarchy);

// Count only actual chapters (non-individual files) as sections
const chapterSections = hierarchySections.filter(section => !section.isIndividualFile);

const firstLesson = lessons[0];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />
    <title>{courseName} - Course Overview</title>
    <meta name="description" content={`Learn ${courseName} with our comprehensive course featuring ${chapterSections.length} sections and ${lessons.length} lessons.`} />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <Navigation pageType="course" currentCourse={course} />

    <!-- Breadcrumb -->
    <nav class="border-b bg-muted/30">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="flex items-center py-4">
          <Button variant="ghost" href="/courses" class="text-sm font-medium hover:text-primary transition-colors">
            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            All Courses
          </Button>
        </div>
      </div>
    </nav>

    <main class="flex-1">
      <!-- Course Header -->
      <section class="py-20 border-b">
        <div class="mx-auto max-w-4xl px-6 lg:px-8">
          <div class="text-center">
            <h1 class="text-5xl font-bold tracking-tight text-foreground sm:text-6xl lg:text-7xl mb-6">
              {courseName}
            </h1>
            <p class="text-xl font-medium text-muted-foreground mb-8 leading-8 max-w-3xl mx-auto">
              {firstLesson?.data.description || `Complete course on ${courseName}`}
            </p>
            <div class="flex items-center justify-center gap-8 text-sm font-semibold text-muted-foreground">
              <div class="flex items-center gap-2">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <span>{chapterSections.length} sections</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>{lessons.length} lessons</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Course Content -->
      <section class="py-20 pb-24">
        <div class="mx-auto max-w-4xl px-6 lg:px-8">
          <div class="space-y-6">
            {hierarchySections.map((section, index) => (
              section.isIndividualFile ? (
                <!-- Direct lesson link -->
                <Card variant="interactive" class="group">
                  <a href={generateLessonUrl(section.lessons[0], course)} class="flex items-center justify-between p-6 text-left">
                    <div class="flex items-center gap-4">
                      <div class="flex items-center justify-center w-12 h-12 bg-primary/10 rounded-lg text-primary font-bold text-lg group-hover:bg-primary/20 transition-colors">
                        {index + 1}
                      </div>
                      <div>
                        <h3 class="text-lg font-bold text-foreground group-hover:text-primary transition-colors">
                          {section.name}
                        </h3>
                      </div>
                    </div>
                    <svg class="h-5 w-5 text-muted-foreground group-hover:text-primary group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </a>
                </Card>
              ) : (
                <!-- Section with lessons -->
                <Card class="overflow-hidden">
                  <div class="border-b bg-muted/30">
                    <button 
                      class="w-full text-left p-6 flex items-center justify-between hover:bg-muted/50 transition-colors chapter-toggle"
                      data-target={`section-${index}`}
                    >
                      <h2 class="text-xl font-bold text-foreground">
                        {section.name}
                      </h2>
                      <svg class="h-5 w-5 text-muted-foreground transition-transform duration-300 toggle-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </button>
                  </div>
                  
                  <div class="section-content overflow-hidden transition-all duration-300 max-h-0" id={`section-${index}`}>
                    {section.lessons && section.lessons.length > 0 && (
                      <div class="divide-y">
                        {section.lessons.map((lesson, lessonIndex) => {
                          const linkUrl = generateLessonUrl(lesson, course);
                          return (
                            <a href={linkUrl} class="flex items-center gap-4 p-4 hover:bg-muted/30 transition-colors group">
                              <div class="flex items-center justify-center w-8 h-8 bg-primary/10 rounded-lg text-sm font-bold text-primary group-hover:bg-primary/20 transition-colors">
                                {lessonIndex + 1}
                              </div>
                              <span class="text-foreground font-medium group-hover:text-primary transition-colors">
                                {lesson.data.title}
                              </span>
                            </a>
                          );
                        })}
                      </div>
                    )}
                    
                    {section.subsections && section.subsections.length > 0 && (
                      <div class="border-t">
                        {section.subsections.map((subsection, subIndex) => (
                          <div class="border-b last:border-b-0">
                            <button 
                              class="w-full text-left p-4 pl-8 flex items-center justify-between hover:bg-muted/50 transition-colors bg-muted/20 chapter-toggle"
                              data-target={`subsection-${index}-${subIndex}`}
                            >
                              <h3 class="text-lg font-semibold text-foreground">
                                {subsection.name}
                              </h3>
                              <svg class="h-4 w-4 text-muted-foreground transition-transform duration-300 toggle-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                              </svg>
                            </button>
                            
                            <div class="section-content overflow-hidden transition-all duration-300 max-h-0" id={`subsection-${index}-${subIndex}`}>
                              {subsection.lessons && subsection.lessons.length > 0 && (
                                <div class="divide-y bg-muted/10">
                                  {subsection.lessons.map((lesson, lessonIndex) => {
                                    const linkUrl = generateLessonUrl(lesson, course);
                                    return (
                                      <a href={linkUrl} class="flex items-center gap-4 p-4 pl-12 hover:bg-muted/30 transition-colors group">
                                        <div class="flex items-center justify-center w-8 h-8 bg-primary/10 rounded-lg text-sm font-bold text-primary group-hover:bg-primary/20 transition-colors">
                                          {lessonIndex + 1}
                                        </div>
                                        <span class="text-foreground font-medium group-hover:text-primary transition-colors">
                                          {lesson.data.title}
                                        </span>
                                      </a>
                                    );
                                  })}
                                </div>
                              )}
                            </div>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </Card>
              )
            ))}
          </div>
        </div>
      </section>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const toggleButtons = document.querySelectorAll('.chapter-toggle');
        
        toggleButtons.forEach(button => {
          button.addEventListener('click', function() {
            const targetId = this.getAttribute('data-target');
            const content = document.getElementById(targetId);
            const icon = this.querySelector('.toggle-icon');
            
            if (content && icon) {
              const isExpanded = content.style.maxHeight && content.style.maxHeight !== '0px';
              
              if (isExpanded) {
                // Collapse
                content.style.maxHeight = '0px';
                icon.style.transform = 'rotate(0deg)';
              } else {
                // Expand
                content.style.maxHeight = content.scrollHeight + 'px';
                icon.style.transform = 'rotate(180deg)';
              }
            }
          });
        });
      });
    </script>
  </body>
</html>