---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  
  // Group by course name
  const courseGroups = courses.reduce((acc, course) => {
    const courseName = course.data.course;
    if (!acc[courseName]) {
      acc[courseName] = [];
    }
    acc[courseName].push(course);
    return acc;
  }, {});

  return Object.keys(courseGroups).map(courseName => ({
    params: { 
      course: courseName.toLowerCase().replace(/\s+/g, '-') 
    },
    props: { 
      courseName,
      lessons: courseGroups[courseName]
    }
  }));
}

const { course } = Astro.params;
const { courseName, lessons } = Astro.props;

// Group lessons by path structure for unlimited nesting
function buildPathHierarchy(lessons) {
  const hierarchy = {};
  
  lessons.forEach(lesson => {
    const pathParts = lesson.slug.split('/').slice(1); // Remove course name
    const fileName = pathParts[pathParts.length - 1];
    const folders = pathParts.slice(0, -1);
    
    let current = hierarchy;
    let fullPath = '';
    
    // Navigate/create folder structure
    folders.forEach((folder, index) => {
      fullPath += (index === 0 ? '' : '/') + folder;
      if (!current[folder]) {
        current[folder] = { 
          _folders: {}, 
          _files: [], 
          _path: fullPath,
          _name: folder 
        };
      }
      current = current[folder]._folders;
    });
    
    // Add file to the current level
    if (!current._files) current._files = [];
    current._files.push(lesson);
  });
  
  return hierarchy;
}

const courseHierarchy = buildPathHierarchy(lessons);

// Recursive function to render hierarchy
function renderHierarchy(hierarchy, depth = 0) {
  let sections = [];
  
  Object.entries(hierarchy).forEach(([key, value]) => {
    if (key === '_files' && value.length > 0) {
      // Root level files
      if (depth === 0) {
        sections.push({
          name: 'Course Files',
          isRoot: true,
          lessons: value.sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
        });
      }
    } else if (key !== '_files' && key !== '_folders' && key !== '_path' && key !== '_name') {
      // Folder section
      const folderData = value;
      const section = {
        name: key.charAt(0).toUpperCase() + key.slice(1).replace(/-/g, ' '),
        isRoot: false,
        depth: depth,
        lessons: (folderData._files || []).sort((a, b) => (a.data.order || 0) - (b.data.order || 0)),
        subsections: renderHierarchy(folderData._folders, depth + 1)
      };
      sections.push(section);
    }
  });
  
  return sections;
}

// Helper function to generate lesson URL
function generateLessonUrl(lesson, courseSlug) {
  const pathParts = lesson.slug.split('/').slice(1); // Remove course name
  return `/courses/${courseSlug}/${pathParts.join('/')}`;
}

const hierarchySections = renderHierarchy(courseHierarchy);

const firstLesson = lessons[0];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{courseName} - Course Overview</title>
  </head>
  <body>
    <nav class="breadcrumb">
      <a href="/courses">← All Courses</a>
    </nav>

    <main class="container">
      <header class="course-header">
        <h1>{courseName}</h1>
        <p>{firstLesson?.data.description || `Complete course on ${courseName}`}</p>
        <div class="course-stats">
          <span>{hierarchySections.length} sections</span>
          <span>{lessons.length} lessons</span>
        </div>
      </header>

      <div class="chapters-list">
        {hierarchySections.map((section, index) => (
          <section class="chapter">
            <h2 class="chapter-title">
              {section.isRoot 
                ? "Course Files" 
                : section.name
              }
            </h2>
            <ul class="lessons-list">
              {section.lessons.map((lesson, lessonIndex) => {
                const linkUrl = generateLessonUrl(lesson, course);
                
                return (
                  <li class="lesson-item">
                    <a href={linkUrl}>
                      <span class="lesson-number">{lessonIndex + 1}</span>
                      <span class="lesson-title">{lesson.data.title}</span>
                      {lesson.data.tags && (
                        <div class="lesson-tags">
                          {lesson.data.tags.map(tag => (
                            <span class="tag">{tag}</span>
                          ))}
                        </div>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    </main>

    <style>
      .breadcrumb {
        padding: 1rem 2rem;
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
      }

      .breadcrumb a {
        color: #2563eb;
        text-decoration: none;
      }

      .breadcrumb a:hover {
        text-decoration: underline;
      }

      .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
      }

      .course-header {
        text-align: center;
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 2px solid #e5e7eb;
      }

      .course-header h1 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: #1f2937;
      }

      .course-header p {
        font-size: 1.2rem;
        color: #6b7280;
        margin-bottom: 1rem;
      }

      .course-stats {
        display: flex;
        justify-content: center;
        gap: 2rem;
        font-size: 1rem;
        color: #9ca3af;
      }

      .chapter {
        margin-bottom: 2rem;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
      }

      .chapter-title {
        background: #f3f4f6;
        padding: 1rem 1.5rem;
        margin: 0;
        font-size: 1.3rem;
        color: #374151;
        border-bottom: 1px solid #e5e7eb;
      }

      .lessons-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .lesson-item {
        border-bottom: 1px solid #f3f4f6;
      }

      .lesson-item:last-child {
        border-bottom: none;
      }

      .lesson-item a {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        text-decoration: none;
        color: #374151;
        transition: background 0.2s;
      }

      .lesson-item a:hover {
        background: #f9fafb;
      }

      .lesson-number {
        background: #2563eb;
        color: white;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: bold;
        flex-shrink: 0;
      }

      .lesson-title {
        flex: 1;
        font-weight: 500;
      }

      .lesson-tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .tag {
        background: #dbeafe;
        color: #1e40af;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.8rem;
      }
    </style>
  </body>
</html>