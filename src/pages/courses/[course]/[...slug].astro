---
import { getCollection } from 'astro:content';
import Navigation from '../../../components/Navigation.astro';
import Head from '../../../components/Head.astro';
import Button from '../../../components/ui/Button.astro';
import '../../../styles/global.css';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  
  return courses.map((lesson) => {
    const courseSlug = lesson.data.course.toLowerCase().replace(/\s+/g, '-');
    const pathParts = lesson.slug.split('/').slice(1); // Remove course name
    
    return {
      params: { 
        course: courseSlug,
        slug: pathParts.join('/') 
      },
      props: { lesson }
    };
  });
}

const { course, slug } = Astro.params;
const { lesson } = Astro.props;

// Get all lessons in this course
const allCourses = await getCollection('courses');
const courseLessons = allCourses.filter(l => l.data.course === lesson.data.course);

// Helper function to generate lesson URL
function generateLessonUrl(lesson) {
  const courseSlug = lesson.data.course.toLowerCase().replace(/\s+/g, '-');
  const pathParts = lesson.slug.split('/').slice(1);
  return `/courses/${courseSlug}/${pathParts.join('/')}`;
}

// Group lessons by their folder structure
const lessonsByFolder = {};
courseLessons.forEach(l => {
  const pathParts = l.slug.split('/').slice(1); // Remove course name
  const folderPath = pathParts.slice(0, -1).join('/') || 'root';
  
  if (!lessonsByFolder[folderPath]) {
    lessonsByFolder[folderPath] = [];
  }
  lessonsByFolder[folderPath].push(l);
});

// Sort lessons within each folder
Object.keys(lessonsByFolder).forEach(folder => {
  lessonsByFolder[folder].sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
});

// Build breadcrumbs
const pathParts = lesson.slug.split('/').slice(1); // Remove course name
const folders = pathParts.slice(0, -1); // Remove filename

const breadcrumbs = [
  { name: 'All Courses', url: '/courses' },
  { name: lesson.data.course, url: `/courses/${course}` }
];

folders.forEach(folder => {
  breadcrumbs.push({
    name: folder.charAt(0).toUpperCase() + folder.slice(1).replace(/-/g, ' '),
    url: null
  });
});

// Find previous and next lessons
const allLessonsFlat = courseLessons.sort((a, b) => a.slug.localeCompare(b.slug));
const currentIndex = allLessonsFlat.findIndex(l => l.slug === lesson.slug);
const prevLesson = currentIndex > 0 ? allLessonsFlat[currentIndex - 1] : null;
const nextLesson = currentIndex < allLessonsFlat.length - 1 ? allLessonsFlat[currentIndex + 1] : null;

const { Content } = await lesson.render();

// Get the raw content for TOC extraction
const lessonContent = lesson.body;
---

<html lang="en">
  <Head 
    title={`${lesson.data.title} - ${lesson.data.course}`}
    description={lesson.data.description}
  />
  <body class="min-h-screen bg-background text-foreground">
    <Navigation 
      pageType="lesson" 
      currentCourse={course} 
      currentLesson={slug} 
      lessonContent={lessonContent}
    />
    
    <!-- Breadcrumb -->
    <nav class="border-b bg-muted/30">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="flex items-center py-4 text-sm font-medium">
          {breadcrumbs.map((crumb, index) => (
            <div class="flex items-center">
              {crumb.url ? (
                <Button variant="ghost" href={crumb.url} class="text-sm p-0 h-auto font-medium hover:text-primary transition-colors">
                  {crumb.name}
                </Button>
              ) : (
                <span class="text-muted-foreground font-medium">{crumb.name}</span>
              )}
              {index < breadcrumbs.length - 1 && (
                <svg class="mx-2 h-4 w-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              )}
            </div>
          ))}
        </div>
      </div>
    </nav>

    <div class="flex min-h-screen">
      <!-- Desktop Sidebar -->
      <aside class="hidden lg:flex w-80 bg-card border-r flex-col">
        <div class="p-6 border-b">
          <h3 class="text-lg font-bold text-foreground">Course Navigation</h3>
        </div>
        <div class="flex-1 overflow-y-auto p-4">
          <div class="space-y-6">
            {Object.entries(lessonsByFolder)
              .sort(([a], [b]) => {
                if (a === 'root') return -1;
                if (b === 'root') return 1;
                return a.localeCompare(b);
              })
              .map(([folderPath, lessons]) => (
                <div class="space-y-2">
                  <h4 class="text-sm font-bold text-muted-foreground uppercase tracking-wider">
                    {folderPath === 'root' 
                      ? 'Course Files' 
                      : folderPath.split('/').map(part => 
                          part.charAt(0).toUpperCase() + part.slice(1).replace(/-/g, ' ')
                        ).join(' / ')
                    }
                  </h4>
                  <div class="space-y-1">
                    {lessons.map(l => (
                      <a 
                        href={generateLessonUrl(l)} 
                        class={`block px-3 py-2 text-sm font-medium rounded-md transition-colors ${
                          l.slug === lesson.slug 
                            ? 'bg-primary text-primary-foreground font-semibold' 
                            : 'text-foreground hover:bg-accent hover:text-accent-foreground'
                        }`}
                      >
                        {l.data.title}
                      </a>
                    ))}
                  </div>
                </div>
              ))}
          </div>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="flex-1 overflow-hidden">
        <div class="mx-auto max-w-4xl px-6 lg:px-8 py-8 pb-24">
          <article class="space-y-8">
            <!-- Lesson Header -->
            <header class="space-y-6 pb-8 border-b">
              <h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl">
                {lesson.data.title}
              </h1>
              
              {lesson.data.description && (
                <p class="text-xl text-muted-foreground leading-8 max-w-3xl">
                  {lesson.data.description}
                </p>
              )}
              
              <div class="flex flex-wrap items-center gap-4">
                {lesson.data.tags && (
                  <div class="flex flex-wrap gap-2">
                    {lesson.data.tags.map(tag => (
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
                {lesson.data.date && (
                  <time class="text-sm font-medium text-muted-foreground">
                    {new Date(lesson.data.date).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                )}
              </div>
            </header>

            <!-- Lesson Content -->
            <div id="lessonContent" class="prose prose-lg prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-28 prose-headings:font-bold prose-headings:tracking-tight lg:prose-headings:scroll-mt-[8.5rem] prose-lead:text-muted-foreground prose-lead:text-xl prose-lead:leading-8 prose-p:text-foreground prose-p:leading-8 prose-a:font-semibold prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-strong:font-bold prose-strong:text-foreground prose-code:bg-muted prose-code:text-foreground prose-code:px-2 prose-code:py-1 prose-code:rounded-md prose-code:text-sm prose-code:font-mono prose-pre:bg-muted prose-pre:border prose-pre:rounded-lg prose-blockquote:border-l-4 prose-blockquote:border-primary/30 prose-blockquote:pl-6 prose-blockquote:text-muted-foreground prose-blockquote:italic prose-th:font-bold prose-th:text-foreground prose-td:text-foreground">
              <Content />
            </div>

            <!-- Navigation -->
            <nav class="flex flex-col sm:flex-row justify-between gap-4 pt-8 border-t">
              {prevLesson ? (
                <Button 
                  variant="outline" 
                  href={generateLessonUrl(prevLesson)} 
                  class="flex items-center gap-3 flex-1 max-w-sm font-medium"
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                  </svg>
                  <div class="text-left">
                    <div class="text-xs font-medium text-muted-foreground">Previous</div>
                    <div class="font-semibold truncate">{prevLesson.data.title}</div>
                  </div>
                </Button>
              ) : (
                <div class="flex-1 max-w-sm"></div>
              )}
              
              {nextLesson ? (
                <Button 
                  href={generateLessonUrl(nextLesson)} 
                  class="flex items-center gap-3 flex-1 max-w-sm ml-auto font-medium"
                >
                  <div class="text-right">
                    <div class="text-xs font-medium text-primary-foreground/80">Next</div>
                    <div class="font-semibold truncate">{nextLesson.data.title}</div>
                  </div>
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m-7-7h18" />
                  </svg>
                </Button>
              ) : (
                <div class="flex-1 max-w-sm"></div>
              )}
            </nav>
          </article>
        </div>
      </main>
    </div>
  </body>
</html>