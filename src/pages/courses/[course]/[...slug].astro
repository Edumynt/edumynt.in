---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Badge from '../../../components/ui/Badge.astro';
import Chatbot from '../../../components/Chatbot.astro';
import { courseUrl, getLessonContexts, lessonUrl } from '../../../lib/course-data';

export async function getStaticPaths() {
  const contexts = await getLessonContexts();

  return contexts.map(context => {
    const [course, ...slugParts] = context.lesson.id.split('/');

    return {
      params: { course, slug: slugParts.join('/') },
      props: { context },
    };
  });
}

const { context } = Astro.props;
const { course, chapter, lesson } = context;

const { Content } = await render(lesson);

const title = lesson.data.title;
const description = lesson.data.description || lesson.data.excerpt || course.data.description;
const progress = context.totalLessons > 0 ? Math.round(((context.lessonIndex + 1) / context.totalLessons) * 100) : 0;
const freshnessDate = lesson.data.updated || lesson.data.date;
const freshnessLabel = freshnessDate
  ? new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(freshnessDate)
  : undefined;
---

<BaseLayout title={title} description={description}>
  <header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur-xl">
    <div class="mx-auto flex max-w-4xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
      <a href={courseUrl(course)} class="inline-flex min-w-0 items-center gap-3 text-sm font-bold text-foreground hover:text-primary">
        <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-muted">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </span>
        <span class="truncate">{course.data.title}</span>
      </a>
      <div class="hidden text-xs font-semibold text-muted-foreground sm:block">
        Lesson {context.lessonIndex + 1} of {context.totalLessons}
      </div>
    </div>
    <div class="h-1 bg-muted">
      <div class="h-full bg-primary transition-all" style={`width: ${progress}%`}></div>
    </div>
  </header>

  <main class="px-4 py-8 pb-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <article
        class="space-y-8"
        data-progress-course-id={context.courseId}
        data-progress-course-title={course.data.title}
        data-progress-lesson-id={lesson.id}
        data-progress-lesson-title={lesson.data.title}
        data-progress-lesson-url={Astro.url.pathname}
        data-progress-total-lessons={context.totalLessons}
      >
        <header class="border-b border-border pb-6">
          <nav class="mb-5 flex flex-wrap items-center gap-2 text-sm font-semibold text-muted-foreground">
            <a href="/courses" class="hover:text-primary">Courses</a>
            <span>/</span>
            <a href={courseUrl(course)} class="hover:text-primary">{course.data.title}</a>
            {chapter && (
              <>
                <span>/</span>
                <span>{chapter.data.title}</span>
              </>
            )}
          </nav>

          <div class="mb-4 flex flex-wrap gap-2">
            <Badge tone="primary" class="capitalize">{lesson.data.type}</Badge>
            <Badge tone="muted" class="capitalize">{lesson.data.difficulty}</Badge>
            {lesson.data.estimatedTime && <Badge tone="muted">{lesson.data.estimatedTime}</Badge>}
            {chapter && <Badge tone="muted">{chapter.data.title}</Badge>}
            {freshnessLabel && <Badge tone="muted">Updated {freshnessLabel}</Badge>}
          </div>

          <div class="mb-4 flex flex-wrap items-start justify-between gap-4">
            <h1 class="ty-display max-w-3xl">{lesson.data.title}</h1>
            <div class="flex gap-2" data-print-hidden>
              <button type="button" data-share-lesson class="rounded-xl border border-border bg-card px-3 py-2 text-sm font-bold text-foreground hover:bg-muted">Share</button>
              <button type="button" data-print-lesson class="rounded-xl border border-border bg-card px-3 py-2 text-sm font-bold text-foreground hover:bg-muted">Print</button>
            </div>
          </div>

          {description && (
            <p class="max-w-3xl text-base leading-relaxed text-muted-foreground md:text-lg">
              {description}
            </p>
          )}

          {lesson.data.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {lesson.data.tags.map(tag => <Badge tone="muted">{tag}</Badge>)}
            </div>
          )}
        </header>

        <div class="prose prose-lg max-w-none dark:prose-invert">
          <Content />
        </div>

        {context.nextLesson ? (
          <div class="border-t border-border pt-8">
            <a href={lessonUrl(context.nextLesson)} class="group flex items-center justify-between gap-4 rounded-2xl bg-primary px-5 py-4 text-primary-foreground transition hover:bg-primary/90">
              <span>
                <span class="mb-1 block text-xs font-bold uppercase tracking-wide opacity-80">Next lesson</span>
                <span class="font-display text-lg font-bold">{context.nextLesson.data.title}</span>
              </span>
              <svg class="h-5 w-5 flex-shrink-0 transition group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        ) : (
          <div class="border-t border-border pt-8">
            <a href={courseUrl(course)} class="inline-flex rounded-2xl bg-muted px-5 py-3 text-sm font-bold text-foreground hover:bg-muted/80">
              Back to course
            </a>
          </div>
        )}
      </article>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const article = document.querySelector('[data-progress-course-id]');
      if (!(article instanceof HTMLElement)) return;

      const storageKey = 'edumynt_course_progress';
      const courseSlug = article.dataset.progressCourseId || '';
      const lessonId = article.dataset.progressLessonId || '';
      const lessonUrl = article.dataset.progressLessonUrl || window.location.pathname;
      const totalLessons = Number(article.dataset.progressTotalLessons || 0);

      if (!courseSlug || !lessonId) return;

      document.querySelector('[data-share-lesson]')?.addEventListener('click', async () => {
        const shareData = { title: document.title, text: document.title, url: window.location.href };
        if (navigator.share) {
          await navigator.share(shareData).catch(() => {});
          return;
        }
        await navigator.clipboard?.writeText(window.location.href).catch(() => {});
      });

      document.querySelector('[data-print-lesson]')?.addEventListener('click', () => window.print());

      try {
        const progress = JSON.parse(localStorage.getItem(storageKey) || '{}');
        const courseProgress = progress.courseProgress?.[courseSlug] || {
          visitedLessons: [],
          totalLessons,
        };

        const visitedLessons = Array.isArray(courseProgress.visitedLessons)
          ? courseProgress.visitedLessons
          : [];

        if (!visitedLessons.includes(lessonId)) {
          visitedLessons.push(lessonId);
        }

        progress.courseProgress = {
          ...(progress.courseProgress || {}),
          [courseSlug]: {
            ...courseProgress,
            totalLessons,
            visitedLessons,
            updatedAt: new Date().toISOString(),
          },
        };

        progress.lastVisitedCourse = {
          courseSlug,
          courseTitle: article.dataset.progressCourseTitle || 'Course',
          lessonId,
          lessonTitle: article.dataset.progressLessonTitle || 'Lesson',
          lessonUrl,
          totalLessons,
          timestamp: new Date().toISOString(),
        };

        localStorage.setItem(storageKey, JSON.stringify(progress));
      } catch {
        localStorage.removeItem(storageKey);
      }
    });
  </script>
  
  <!-- Course Chatbot -->
  <Chatbot courseId={context.courseId} client:load />
</BaseLayout>
