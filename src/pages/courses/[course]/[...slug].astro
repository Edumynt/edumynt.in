---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons
    .filter(l => l.data.status === 'published')
    .filter((lesson) => {
      const parts = lesson.id.split('/');
      return parts.length >= 3 && parts[0] && !parts.at(-1)?.startsWith('index');
    })
    .map((lesson) => {
      // lesson.id format: "course-name/chapter-name/lesson-file"
      const [course, ...slugParts] = lesson.id.split('/');

      return {
        params: { course, slug: slugParts.join('/') },
        props: { lesson },
      };
    });
}

const { lesson } = Astro.props;

const idParts = lesson.id.split('/');
const courseId = idParts[0];
const chapterId = idParts.length > 2 ? idParts[1] : null;

const { Content } = await render(lesson);

const title = `${lesson.data.title} - Edumynt`;
const description = lesson.data.description || '';
---

<BaseLayout title={title} description={description}>
  <Navigation pageType="lesson" />

  <main class="pt-20">
    <div class="mx-auto max-w-4xl px-6 lg:px-8 py-8">
      <article class="space-y-8">
        <header class="space-y-3 pb-4 border-b">
          <nav class="text-sm text-muted-foreground mb-2">
            <a href="/courses" class="hover:text-primary">Courses</a>
            <span class="mx-2">›</span>
            <a href={`/courses/${courseId}`} class="hover:text-primary capitalize">{courseId.replace(/-/g, ' ')}</a>
            {chapterId && (
              <>
                <span class="mx-2">›</span>
                <span class="capitalize">{chapterId.replace(/-/g, ' ')}</span>
              </>
            )}
          </nav>

          <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-foreground leading-tight">
            {lesson.data.title}
          </h1>

          {lesson.data.description && (
            <p class="text-base text-muted-foreground leading-relaxed max-w-3xl">
              {lesson.data.description}
            </p>
          )}

          <div class="flex flex-wrap items-center gap-3">
            {lesson.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {lesson.data.tags.map(tag => (
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary/10 text-primary">
                    {tag}
                  </span>
                ))}
              </div>
            )}
            {lesson.data.estimatedTime && (
              <span class="text-xs font-medium text-muted-foreground">
                ⏱ {lesson.data.estimatedTime}
              </span>
            )}
          </div>
        </header>

        <div class="prose prose-lg max-w-none dark:prose-invert">
          <Content />
        </div>
      </article>
    </div>
  </main>
</BaseLayout>
