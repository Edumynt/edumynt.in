---
import { getCollection } from 'astro:content';
import Navigation from '../../components/Navigation.astro';

const courses = await getCollection('courses');

// Group courses by course name
const courseGroups = courses.reduce((acc, course) => {
  const courseName = course.data.course;
  if (!acc[courseName]) {
    acc[courseName] = [];
  }
  acc[courseName].push(course);
  return acc;
}, {});

// Get unique courses with their metadata
const uniqueCourses = Object.entries(courseGroups).map(([courseName, lessons]) => {
  const firstLesson = lessons[0];
  const lessonCount = lessons.length;
  const chapters = [...new Set(lessons.map(lesson => lesson.data.chapter).filter(Boolean))];
  
  return {
    name: courseName,
    slug: courseName.toLowerCase().replace(/\s+/g, '-'),
    title: courseName,
    description: firstLesson.data.description || `Learn ${courseName}`,
    lessonCount,
    chapterCount: chapters.length,
    lastUpdated: Math.max(...lessons.map(l => l.data.updated?.getTime() || l.data.date?.getTime() || 0))
  };
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />
    <title>Courses - Learn with Edumynt</title>
    <meta name="description" content="Browse all available courses on Edumynt - interactive learning platform for literature, periods, movements, and writers." />
  </head>
  <body>
    <Navigation pageType="courses" />

    <main class="container">
      <header>
        <h1>Available Courses</h1>
        <p>Choose a course to start your learning journey</p>
      </header>

      <div class="courses-grid">
        {uniqueCourses.map((course) => (
          <article class="course-card">
            <h2>
              <a href={`/courses/${course.slug}`}>
                {course.title}
              </a>
            </h2>
            <p class="description">{course.description}</p>
            <div class="course-meta">
              <span class="chapters">{course.chapterCount} chapters</span>
              <span class="lessons">{course.lessonCount} lessons</span>
            </div>
            <a href={`/courses/${course.slug}`} class="course-link">
              Start Course →
            </a>
          </article>
        ))}
      </div>
    </main>

    <style>
      :root {
        --bg-color: #f8fafc;
        --text-color: #1a1a1a;
        --card-bg: white;
        --border-color: #e5e7eb;
        --accent-color: #667eea;
        --hover-bg: #f3f4f6;
      }

      :root[data-theme="dark"] {
        --bg-color: #0f172a;
        --text-color: #f1f5f9;
        --card-bg: #1e293b;
        --border-color: #334155;
        --accent-color: #818cf8;
        --hover-bg: #334155;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: var(--text-color);
        background: var(--bg-color);
        margin: 0;
        padding: 0;
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
      }

      header {
        text-align: center;
        margin-bottom: 3rem;
      }

      h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        color: var(--text-color);
      }

      header p {
        font-size: 1.2rem;
        color: #666;
      }

      .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
      }

      .course-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1.5rem;
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .course-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      }

      .course-card h2 {
        margin: 0 0 1rem 0;
        font-size: 1.5rem;
      }

      .course-card h2 a {
        text-decoration: none;
        color: var(--accent-color);
      }

      .course-card h2 a:hover {
        text-decoration: underline;
      }

      .description {
        color: #666;
        margin-bottom: 1rem;
        line-height: 1.6;
      }

      .course-meta {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        font-size: 0.9rem;
        color: #888;
      }

      .course-link {
        display: inline-block;
        background: var(--accent-color);
        color: white;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        font-weight: 500;
        transition: background 0.2s;
      }

      .course-link:hover {
        background: #1d4ed8;
      }

      @media (max-width: 768px) {
        .container {
          padding: 1rem;
        }

        h1 {
          font-size: 2rem;
        }

        header p {
          font-size: 1rem;
        }

        .courses-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }

        .course-card {
          padding: 1.25rem;
        }
      }
    </style>
  </body>
</html>