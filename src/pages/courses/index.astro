---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import CourseCard from '../../components/course/CourseCard.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { getCourseOutlines } from '../../lib/course-data';

const outlines = await getCourseOutlines();
const chapterCount = outlines.reduce((total, outline) => total + outline.stats.chapterCount, 0);
const lessonCount = outlines.reduce((total, outline) => total + outline.stats.lessonCount, 0);

const title = 'All Courses';
const description = 'Browse all available courses on Edumynt.';
---

<BaseLayout title={title} description={description}>
  <Navigation pageType="courses" />

  <main class="flex-1 px-4 py-6 pb-24 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <PageHeader
        eyebrow="Course Library"
        title="All Courses"
        description="Choose a course to see its complete chapter and lesson path."
        stats={[
          { label: 'Courses', value: outlines.length },
          { label: 'Chapters', value: chapterCount },
          { label: 'Lessons', value: lessonCount },
        ]}
      />

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        {outlines.map(outline => (
          <CourseCard outline={outline} />
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
