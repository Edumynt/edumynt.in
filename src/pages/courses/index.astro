---
import { getCollection } from 'astro:content';
import Navigation from '../../components/Navigation.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import '../../styles/global.css';

const courses = await getCollection('courses');

// Group courses by course name
const courseGroups = courses.reduce((acc, course) => {
  const courseName = course.data.course;
  if (!acc[courseName]) {
    acc[courseName] = [];
  }
  acc[courseName].push(course);
  return acc;
}, {});

// Get unique courses with their metadata
const uniqueCourses = Object.entries(courseGroups).map(([courseName, lessons]) => {
  const firstLesson = lessons[0];
  const lessonCount = lessons.length;
  const chapters = [...new Set(lessons.map(lesson => lesson.data.chapter).filter(Boolean))];
  
  // Find a lesson with an image, prefer syllabus or main course file
  const courseImage = lessons.find(lesson => lesson.data.image)?.data.image || 
                     `/images/courses/${courseName.toLowerCase().replace(/\s+/g, '-')}.jpg`;
  
  return {
    name: courseName,
    slug: courseName.toLowerCase().replace(/\s+/g, '-'),
    title: courseName,
    description: firstLesson.data.description || `Learn ${courseName}`,
    image: courseImage,
    lessonCount,
    chapterCount: chapters.length,
    lastUpdated: Math.max(...lessons.map(l => l.data.updated?.getTime() || l.data.date?.getTime() || 0))
  };
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />
    <title>Courses - Edumynt</title>
    <meta name="description" content="Browse all available courses on Edumynt." />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <Navigation pageType="courses" />

    <main class="flex-1 p-6 pb-20">
      <div class="mx-auto max-w-7xl">
        <!-- Simple Header -->
        <div class="mb-6">
          <h1 class="text-2xl font-bold text-foreground mb-1">All Courses</h1>
          <p class="text-sm text-muted-foreground">Choose a course to start learning</p>
        </div>
        
        <!-- Course Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {uniqueCourses.map((course) => (
            <a 
              href={`/courses/${course.slug}`}
              class="group block bg-card border border-border rounded-xl overflow-hidden hover:border-primary/30 hover:shadow-lg transition-all duration-200 hover:scale-[1.02]"
            >
              <!-- 16:9 Image Container -->
              <div class="relative w-full aspect-video bg-gradient-to-br from-primary/10 to-primary/5 overflow-hidden">
                <img 
                  src={course.image} 
                  alt={course.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  onerror="this.src='data:image/svg+xml;base64,'"
                />
                <!-- Overlay gradient for better text readability -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              </div>
              
              <!-- Card Content -->
              <div class="p-4">
                <h3 class="font-semibold text-foreground group-hover:text-primary transition-colors text-lg leading-tight mb-2">
                  {course.name}
                </h3>
                
                <p class="text-sm text-muted-foreground mb-3 line-clamp-2">
                  {course.description}
                </p>
                
                <div class="flex items-center gap-4 text-xs text-muted-foreground">
                  <span class="flex items-center gap-1">
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    {course.chapterCount} chapters
                  </span>
                  <span class="flex items-center gap-1">
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    {course.lessonCount} lessons
                  </span>
                </div>
                
                <!-- Action indicator -->
                <div class="flex justify-end mt-3 opacity-0 group-hover:opacity-100 transition-opacity">
                  <svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </main>
  </body>
</html>